{
  "name": "calendar-ghim",
  "version": "0.1.0",
  "private": true,
  "description": "Ghim — sàn rao vặt, bản làm lại — Fastify + Prisma + PostgreSQL",
  "type": "module",
  "main": "./dist/server.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.development src/server.ts",
    "start": "node --enable-source-maps --env-file-if-exists=.env.production dist/server.js",
    "start:local": "node --enable-source-maps --env-file=.env.development dist/server.js",
    "build": "pnpm run clean && prisma generate && tsc -p tsconfig.build.json && pnpm run build:data",
    "build:data": "node -e \"const fs=require('node:fs');for(const dir of fs.globSync('src/**/data'))fs.cpSync(dir,dir.replace(/^src/,'dist'),{recursive:true})\"",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:deploy:prod": "node --env-file=.env.production node_modules/prisma/build/index.js migrate deploy",
    "db:drift": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "db:up": "docker compose up -d --wait postgres",
    "db:test:up": "docker compose up -d --wait postgres-test",
    "mail:up": "docker compose up -d --wait mailpit",
    "storage:up": "docker compose up -d --wait storage",
    "storage:test:up": "docker compose up -d --wait storage-test",
    "cli:create-master": "tsx --env-file-if-exists=.env.development src/cli/create-master.ts",
    "cli:reset-2fa": "tsx --env-file-if-exists=.env.development src/cli/reset-two-factor.ts",
    "cli:build-regions": "tsx src/cli/build-regions.ts",
    "spec:validate": "openspec validate --all --strict --no-interactive",
    "spec:list": "openspec list && openspec list --specs",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run spec:validate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/s3-request-presigner": "^3.1149.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/jwt": "^10.2.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.9.0",
    "@fastify/swagger-ui": "^6.1.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "argon2": "^0.45.1",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "google-auth-library": "^11.1.0",
    "nodemailer": "^10.0.16",
    "otplib": "^13.5.0",
    "pg-boss": "^12.37.0",
    "pino": "^10.3.1",
    "socket.io": "^4.8.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.14.1",
    "@types/node": "^24.13.6",
    "@types/nodemailer": "^8.0.2",
    "@vitest/coverage-v8": "^5.0.1",
    "dotenv": "^18.0.3",
    "oxlint": "1.84.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.8",
    "prisma": "7.10.0",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
