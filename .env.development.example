# Chép thành `.env.development` rồi sửa. Chỉ file `*.example` được commit.
NODE_ENV=development
LOG_LEVEL=debug
PORT=3100
APP_NAME=calendar-ghim

# Container `postgres` trong docker-compose.yml (`pnpm db:up`). Tên DB phải kết thúc bằng `_dev`.
DATABASE_URL=postgresql://ghim:ghim@localhost:5435/ghim_dev

# `*` chỉ dùng ở dev. Bàn vận hành dùng cookie thì phải là danh sách origin cụ thể.
CORS_ORIGIN=*
RATE_LIMIT_MAX=100

# ── identity ──
# Khoá ký access token và khoá HMAC băm email / thiết bị: tối thiểu 32 ký tự, phải khác nhau.
JWT_SECRET=dev-only-jwt-secret-doi-truoc-khi-len-production-01
IDENTITY_HASH_KEY=dev-only-identity-hash-key-doi-truoc-khi-len-prod-01
# Đúng 32 byte base64 (`openssl rand -base64 32`): mã hoá bí mật TOTP và số giấy tờ.
SECRETS_ENCRYPTION_KEY=qyWKW1d5RWv6rBSvZRnlQIeFurXDtbrn2oOjPh21qp8=
# Mailpit (`pnpm mail:up`): nhận mọi user/pass, thư hiện ở http://localhost:8025. Mã xác nhận
# không bao giờ vào log nên dev không có SMTP là không đọc được mã.
SMTP_URL=smtp://ghim:ghim@localhost:1025
MAIL_FROM=Ghim <no-reply@ghim.local>
# Client id Google (iOS, Android…) phân tách bằng dấu phẩy. Trống = đăng nhập Google tắt.
GOOGLE_CLIENT_IDS=
# Có mặc định (danh sách công khai của dự án disposable-email-domains); chỉ đổi khi cần nguồn khác.
# DISPOSABLE_DOMAINS_URL=https://disposable.github.io/disposable-email-domains/domains.txt
