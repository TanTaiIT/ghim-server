# Chép thành `.env.development` rồi sửa. Chỉ file `*.example` được commit.
NODE_ENV=development
LOG_LEVEL=debug
PORT=3100
APP_NAME=calendar-ghim

# Container `postgres` trong docker-compose.yml (`pnpm db:up`). Tên DB phải kết thúc bằng `_dev`.
DATABASE_URL=postgresql://ghim:ghim@localhost:5435/ghim_dev

# `*` chỉ dùng ở dev. Bàn vận hành dùng cookie thì phải là danh sách origin cụ thể.
CORS_ORIGIN=*
RATE_LIMIT_MAX=100
