# Production nên lấy biến từ nền tảng deploy. Dùng file này chỉ khi chạy tay trên một máy
# (`pnpm start`, `pnpm db:deploy:prod`): chép thành `.env.production`, KHÔNG commit bản thật.
NODE_ENV=production
LOG_LEVEL=info
PORT=3100
APP_NAME=calendar-ghim

# Tên DB KHÔNG được kết thúc bằng `_dev` / `_test` — app và Prisma CLI đều từ chối khởi động.
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/ghim

# Danh sách origin cụ thể, phân tách bằng dấu phẩy. Không để `*` ở production.
CORS_ORIGIN=https://<app-domain>,https://<ops-domain>
RATE_LIMIT_MAX=100

# ── identity ──
# Hai khoá ngẫu nhiên ≥ 32 ký tự, KHÁC nhau. Đổi IDENTITY_HASH_KEY là mất mọi dấu băm email và
# thiết bị đã có (không nối được gậy qua lần đăng ký lại) — xoay khoá này là một quyết định, không
# phải việc bảo trì định kỳ.
JWT_SECRET=<openssl rand -hex 32>
IDENTITY_HASH_KEY=<openssl rand -hex 32>
# Đúng 32 byte base64. Mất khoá = mất mọi bí mật TOTP và số giấy tờ đã mã hoá.
SECRETS_ENCRYPTION_KEY=<openssl rand -base64 32>
# SMTP của nhà cung cấp (Resend / Postmark / SES…).
SMTP_URL=smtps://<user>:<password>@<smtp-host>:465
MAIL_FROM=Ghim <no-reply@<domain>>
# Client id Google của app iOS và Android, phân tách bằng dấu phẩy. Bắt buộc ở production.
GOOGLE_CLIENT_IDS=<ios-client-id>.apps.googleusercontent.com,<android-client-id>.apps.googleusercontent.com
# Có mặc định; chỉ đổi khi dùng nguồn danh sách khác.
# DISPOSABLE_DOMAINS_URL=https://disposable.github.io/disposable-email-domains/domains.txt
