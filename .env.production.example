# Production nên lấy biến từ nền tảng deploy. Dùng file này chỉ khi chạy tay trên một máy
# (`pnpm start`, `pnpm db:deploy:prod`): chép thành `.env.production`, KHÔNG commit bản thật.
NODE_ENV=production
LOG_LEVEL=info
PORT=3100
APP_NAME=calendar-ghim

# Tên DB KHÔNG được kết thúc bằng `_dev` / `_test` — app và Prisma CLI đều từ chối khởi động.
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/ghim

# Danh sách origin cụ thể, phân tách bằng dấu phẩy. Không để `*` ở production.
CORS_ORIGIN=https://<app-domain>,https://<ops-domain>
RATE_LIMIT_MAX=100
