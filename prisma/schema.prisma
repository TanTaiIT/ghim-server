// Quy ước trong file này:
//   - Tên bảng/cột trong DB là snake_case (@map/@@map), code đọc camelCase.
//   - Thời điểm luôn timestamptz. Postgres lưu mốc tuyệt đối, việc đổi sang Asia/Ho_Chi_Minh
//     là của tầng hiển thị — lưu `timestamp` trần là mất múi giờ ngay lúc ghi.
//   - Giá là BigInt, đơn vị ĐỒNG, không âm; 0 = cho tặng. Không Float.
//   - Id uuid v7 do Postgres 18 sinh (`uuidv7()`): tăng theo thời gian nên index ghi dồn về cuối
//     thay vì rải ngẫu nhiên như v4.
//   - KHÔNG multi-tenant: một sàn dùng chung. Phạm vi xem theo nhóm là luật nghiệp vụ của module
//     `listing`, không phải cách ly dữ liệu như `shop_id` của booking.
//   - Trạng thái tin, cờ tạm ẩn và lý do hạn chế hiển thị là BA cột riêng — gộp làm một là lặp lại
//     lỗi "Đã ẩn" của hệ thống cũ (THIET-KE-HE-THONG.md phần 4, 15, 19).
//   - CHECK viết tay nằm trong migration; model nào có CHECK thì ghi `///` ngay trên model, tên
//     constraint trùng tên trong SQL để `pnpm db:drift` và người đọc đối chiếu được.
//   - Cột "ai làm" (`locked_by`, `cleared_by`, `reviewed_by`, `removed_by`) là uuid trần, không FK:
//     nhật ký phải còn nguyên khi tài khoản người làm bị xoá hẳn.

generator client {
  provider        = "prisma-client-js"
  // Khai được index có WHERE ngay trong schema (Prisma ≥ 7.4) — thiếu cờ này thì index viết tay
  // trong SQL bị `migrate dev` coi là lệch và tự sinh lệnh DROP ở migration kế tiếp.
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ── IDENTITY: ENUM ───────────────────────────────────────────────────────────────────────────────

enum AccountStatus {
  pending_verification
  active
  locked
  deleted

  @@map("account_status")
}

enum AccountRole {
  user
  master

  @@map("account_role")
}

enum CodePurpose {
  email_verify
  password_reset
  email_change
  /// Người bị khoá vì gậy nghiêm trọng chứng minh sở hữu email để khiếu nại qua kênh hỗ trợ (add-strikes).
  locked_appeal

  @@map("code_purpose")
}

enum SessionRevokeReason {
  logout
  evicted
  password_changed
  password_reset
  revoked_by_user
  account_locked
  account_deleted
  refresh_reuse
  /// Xác nhận email mới thu hồi mọi phiên khác (fix-audit-identity, T12).
  email_changed

  @@map("session_revoke_reason")
}

enum AccountFlagKind {
  many_accounts_on_device
  device_of_locked_account
  /// Đăng tin lần đầu trên máy sau khi một tài khoản cùng máy nhận gậy (add-strikes) — hết khi gậy hết hiệu lực.
  device_of_struck_account

  @@map("account_flag_kind")
}

enum DisposableDomainSource {
  seed
  manual

  @@map("disposable_domain_source")
}

enum IdVerificationStatus {
  pending
  verified
  rejected

  @@map("id_verification_status")
}

// ── IDENTITY: BẢNG ───────────────────────────────────────────────────────────────────────────────

/// CHECK tay (migration init_identity, nới ở anonymize_deleted_accounts):
///   accounts_credential_check: status = 'deleted' OR password_hash IS NOT NULL OR google_sub IS NOT NULL
///   accounts_locked_check:     (status = 'locked')  = (locked_at IS NOT NULL)
///   accounts_deleted_check:    (status = 'deleted') = (deleted_at IS NOT NULL)
/// CHECK tay (migration account_avatar):
///   accounts_avatar_source_check: NOT (avatar_image_id IS NOT NULL AND avatar_from_google)
///   accounts_avatar_google_check: NOT avatar_from_google OR google_picture_url IS NOT NULL
model Account {
  id                String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Email như người dùng gõ — chỉ để gửi thư. So trùng luôn dùng `emailNormalized`.
  email             String
  emailNormalized   String         @unique @map("email_normalized")
  /// HMAC-SHA256 với `IDENTITY_HASH_KEY`: `trust` nối gậy qua lần đăng ký lại mà không giữ email.
  emailHash         String         @map("email_hash")
  passwordHash      String?        @map("password_hash")
  googleSub         String?        @unique @map("google_sub")
  status            AccountStatus  @default(pending_verification)
  role              AccountRole    @default(user)
  displayName       String         @map("display_name")
  /// Ảnh của tài khoản Google, lấy lại mỗi lần đăng nhập Google — ngoại lệ duy nhất ngoài kho (TK 25).
  googlePictureUrl  String?        @map("google_picture_url")
  /// Mã ảnh của `media` (chủ `profile`), không FK chéo module: khoá trong kho suy từ mã nên cấp đường xem không
  /// phải hỏi `media`.
  avatarImageId     String?        @map("avatar_image_id") @db.Uuid
  avatarFromGoogle  Boolean        @default(false) @map("avatar_from_google")
  /// Lần cuối hoạt động (add-activity-status): ghi khi một kết nối realtime mở và khi kết nối cuối cùng đóng; xoá khi xoá tài khoản.
  lastSeenAt        DateTime?      @map("last_seen_at") @db.Timestamptz(3)
  /// Công tắc hai chiều: tắt thì không ai thấy trạng thái của mình, mình cũng không thấy của ai.
  showActivity      Boolean        @default(true) @map("show_activity")
  phone             String?
  /// Tỉnh/thành của tôi (add-home-province): chỉ chủ tài khoản thấy; app dùng cho "Gần bạn" và bộ lọc mặc định.
  homeProvinceCode  Int?           @map("home_province_code")
  lockedReason      String?        @map("locked_reason")
  lockedAt          DateTime?      @map("locked_at") @db.Timestamptz(3)
  lockedBy          String?        @map("locked_by") @db.Uuid
  /// Trạng thái lúc bị khoá: mở khoá trả về đúng nó, email chưa xác nhận vẫn chưa xác nhận. CHECK
  /// `accounts_status_before_lock_check`: có giá trị khi và chỉ khi đang khoá, là `active` / `pending_verification`.
  statusBeforeLock  AccountStatus? @map("status_before_lock")
  deletedAt         DateTime?      @map("deleted_at") @db.Timestamptz(3)
  emailChangedAt    DateTime?      @map("email_changed_at") @db.Timestamptz(3)
  /// Lượt xoá hẳn của `ops` đã qua (tin xoá, ảnh đại diện xoá, hồ sơ ẩn danh) — dòng giữ cho lịch sử chống gian lận.
  purgedAt          DateTime?      @map("purged_at") @db.Timestamptz(3)
  passwordChangedAt DateTime?      @map("password_changed_at") @db.Timestamptz(3)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  verificationCodes     VerificationCode[]
  sessions              Session[]
  devicePosts           DevicePost[]
  deviceLogins          DeviceLogin[]
  savedListings         SavedListing[]
  savedSearches         SavedSearch[]
  homeProvince          Province?                @relation(fields: [homeProvinceCode], references: [code], onDelete: SetNull)
  deviceClearances      DeviceClearance[]
  flags                 AccountFlag[]
  idVerifications       IdVerification[]
  staffPermission       StaffPermission?
  groupMemberships      GroupMember[]
  groupBans             GroupBan[]
  groupJoinRequests     GroupJoinRequest[]
  groupInvitations      GroupInvitation[]
  groupOwnerOffers      GroupOwnerOffer[]
  notifications         Notification[]
  notificationPrefs     NotificationPreference[]
  groupMutes            GroupNotificationMute[]
  images                Image[]
  listings              Listing[]
  listingSubmissions    ListingSubmission[]
  trustCleanListings    TrustCleanListing[]
  trustTier             TrustTierResult?
  trustTierChanges      TrustTierChange[]
  screeningRuns         ScreeningRun[]
  screeningCooldown     ScreeningCooldown?
  conversationsAsBuyer  Conversation[]           @relation("conversation_buyer")
  conversationsAsSeller Conversation[]           @relation("conversation_seller")
  messages              Message[]
  blocks                AccountBlock[]           @relation("block_blocker")
  blockedBy             AccountBlock[]           @relation("block_blocked")

  @@index([emailHash])
  @@index([status, createdAt])
  @@index([status, deletedAt])
  @@index([deletedAt], where: raw("status = 'deleted' AND purged_at IS NULL"), map: "accounts_purge_due_idx")
  @@map("accounts")
}

/// CHECK tay (migration init_identity):
///   verification_codes_attempts_check: attempts >= 0
///   verification_codes_target_check:   purpose <> 'email_change' OR target_email IS NOT NULL
model VerificationCode {
  id          String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  accountId   String      @map("account_id") @db.Uuid
  purpose     CodePurpose
  /// DB chỉ giữ HMAC của mã: lộ bảng không lộ mã đang sống.
  codeHash    String      @map("code_hash")
  /// Chỉ `email_change` có: email mới đang chờ xác nhận, email cũ vẫn là email đăng nhập.
  targetEmail String?     @map("target_email")
  attempts    Int         @default(0)
  expiresAt   DateTime    @map("expires_at") @db.Timestamptz(3)
  consumedAt  DateTime?   @map("consumed_at") @db.Timestamptz(3)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  // Một mã sống mỗi mục đích: xin mã mới = đánh dấu consumed_at cho mã cũ rồi tạo mã mới trong
  // cùng transaction. DB là chốt cuối, service không được coi kiểm trước là đủ.
  @@unique([accountId, purpose], where: raw("consumed_at IS NULL"), map: "verification_codes_live_key")
  @@map("verification_codes")
}

/// CHECK tay (migration init_identity):
///   sessions_revoke_check: (revoked_at IS NULL) = (revoke_reason IS NULL)
model Session {
  id                   String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  accountId            String               @map("account_id") @db.Uuid
  /// SHA-256 của refresh token; token thật chỉ nằm ở thiết bị. Xoay mỗi lần refresh.
  refreshTokenHash     String               @unique @map("refresh_token_hash")
  /// Băm của token vừa bị xoay: ai dùng lại nó là token đã lộ → thu hồi cả phiên (design 4).
  prevRefreshTokenHash String?              @map("prev_refresh_token_hash")
  deviceName           String               @map("device_name")
  ip                   String?
  userAgent            String?              @map("user_agent")
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  lastActiveAt         DateTime             @default(now()) @map("last_active_at") @db.Timestamptz(3)
  /// Hết hạn trượt: last_active_at + 30 ngày (giá trị khởi đầu), cập nhật khi refresh.
  expiresAt            DateTime             @map("expires_at") @db.Timestamptz(3)
  revokedAt            DateTime?            @map("revoked_at") @db.Timestamptz(3)
  revokeReason         SessionRevokeReason? @map("revoke_reason")
  /// Token Expo Push của máy đang giữ phiên này (add-notifications): một token một phiên; phiên thu hồi thì máy hết nhận.
  pushToken            String?              @unique @map("push_token")

  account     Account                @relation(fields: [accountId], references: [id], onDelete: Cascade)
  pushTickets PushTicket[]
  presences   ConversationPresence[]

  // Đếm phiên đang sống và tìm phiên ít hoạt động nhất để đẩy ra — một index phục vụ cả hai.
  @@index([accountId, revokedAt, lastActiveAt])
  @@index([prevRefreshTokenHash])
  /// Hai index cho việc dọn phiên hằng đêm (`revoked_at < x OR expires_at < x`): Postgres gộp bằng
  /// BitmapOr thay vì quét cả bảng. `refresh_token_hash` vốn đổi mỗi lần làm mới nên lượt ghi đó
  /// đã cập nhật index — thêm `expires_at` chỉ thêm một index, không làm mất HOT update.
  @@index([expiresAt])
  @@index([revokedAt], where: raw("revoked_at IS NOT NULL"), map: "sessions_revoked_idx")
  @@index([createdAt], where: raw("ip IS NOT NULL"), map: "sessions_ip_retention_idx")
  @@map("sessions")
}

/// CHECK tay (migration init_identity):
///   device_posts_order_check: last_posted_at >= first_posted_at
model DevicePost {
  /// HMAC của mã thiết bị app gửi lên; mã thật không bao giờ vào DB hay response.
  deviceHash    String   @map("device_hash")
  accountId     String   @map("account_id") @db.Uuid
  firstPostedAt DateTime @map("first_posted_at") @db.Timestamptz(3)
  lastPostedAt  DateTime @map("last_posted_at") @db.Timestamptz(3)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([deviceHash, accountId])
  @@index([accountId])
  @@index([lastPostedAt])
  @@map("device_posts")
}

/// CHECK tay (migration add_device_logins):
///   device_logins_order_check: last_seen_at >= first_seen_at
model DeviceLogin {
  /// HMAC của mã thiết bị app gửi lúc đăng nhập (add-login-device-marks). Chỉ nuôi luật xung đột lợi ích và luật
  /// người hỏi mua — không nuôi đánh dấu gian lận, thứ vẫn chỉ tính lượt đăng tin (`device_posts`).
  deviceHash  String   @map("device_hash")
  accountId   String   @map("account_id") @db.Uuid
  firstSeenAt DateTime @map("first_seen_at") @db.Timestamptz(3)
  lastSeenAt  DateTime @map("last_seen_at") @db.Timestamptz(3)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([deviceHash, accountId])
  @@index([accountId])
  @@index([lastSeenAt])
  @@map("device_logins")
}

model DeviceClearance {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  deviceHash String   @map("device_hash")
  accountId  String   @map("account_id") @db.Uuid
  clearedAt  DateTime @default(now()) @map("cleared_at") @db.Timestamptz(3)
  clearedBy  String   @map("cleared_by") @db.Uuid
  reason     String

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([deviceHash, accountId])
  @@map("device_clearances")
}

/// CHECK tay (migration init_identity):
///   account_flags_cleared_check: (cleared_at IS NULL) = (cleared_reason IS NULL)
///   account_flags_related_check: kind <> 'device_of_locked_account' OR related_account_id IS NOT NULL
model AccountFlag {
  id               String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  accountId        String          @map("account_id") @db.Uuid
  kind             AccountFlagKind
  deviceHash       String          @map("device_hash")
  /// Tài khoản bị khoá mà đánh dấu `device_of_locked_account` nói tới; uuid trần vì chỉ để tra
  /// cứu, không FK — tài khoản kia bị xoá hẳn thì đánh dấu vẫn còn đọc được.
  relatedAccountId String?         @map("related_account_id") @db.Uuid
  /// Gậy mà đánh dấu `device_of_struck_account` nói tới — gậy hết hiệu lực thì đánh dấu đóng (add-strikes).
  relatedStrikeId  String?         @map("related_strike_id") @db.Uuid
  /// 8 ký tự Crockford base32 từ 5 byte ngẫu nhiên: không mang thông tin gì về loại, tài khoản
  /// hay thiết bị — người dùng chỉ đưa mã này cho hỗ trợ.
  lookupCode       String          @unique @map("lookup_code")
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  clearedAt        DateTime?       @map("cleared_at") @db.Timestamptz(3)
  clearedBy        String?         @map("cleared_by") @db.Uuid
  clearedReason    String?         @map("cleared_reason")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, kind, deviceHash], where: raw("cleared_at IS NULL"), map: "account_flags_open_key")
  @@index([accountId])
  @@index([clearedAt], where: raw("cleared_at IS NOT NULL"), map: "account_flags_cleared_idx")
  @@map("account_flags")
}

model DisposableDomain {
  domain    String                 @id
  source    DisposableDomainSource
  addedAt   DateTime               @default(now()) @map("added_at") @db.Timestamptz(3)
  /// Bia mộ: master bỏ một miền thì giữ dòng với removed_at để lượt cập nhật tự động không
  /// hồi sinh nó (INSERT … ON CONFLICT DO NOTHING vấp dòng này).
  removedAt DateTime?              @map("removed_at") @db.Timestamptz(3)
  removedBy String?                @map("removed_by") @db.Uuid

  @@map("disposable_domains")
}

/// CHECK tay (migration init_identity):
///   id_verifications_reason_check: status <> 'rejected' OR reason IS NOT NULL
model IdVerification {
  id                String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  accountId         String               @map("account_id") @db.Uuid
  documentType      String               @map("document_type")
  /// AES-256-GCM bằng `SECRETS_ENCRYPTION_KEY`; không response nào trả số giấy tờ.
  documentNumberEnc String               @map("document_number_enc")
  fullName          String               @map("full_name")
  status            IdVerificationStatus @default(pending)
  reviewedBy        String?              @map("reviewed_by") @db.Uuid
  reviewedAt        DateTime?            @map("reviewed_at") @db.Timestamptz(3)
  reason            String?
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId], where: raw("status = 'pending'"), map: "id_verifications_pending_key")
  @@map("id_verifications")
}

// ── HẠ TẦNG DÙNG CHUNG ───────────────────────────────────────────────────────────────────────────

/// Không module nghiệp vụ nào sở hữu (như `_prisma_migrations`): module ghi qua
/// `appendEvents(tx, …)` trong cùng transaction với thay đổi gốc; bộ phát tối thiểu ở
/// `src/common/outbox/dispatcher.ts` đọc, gọi bên nghe, đánh dấu `published_at`; `ops` nhận lại sau.
model OutboxEvent {
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  type          String
  payload       Json      @db.JsonB
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(3)
  /// Số lần bên nghe ném; sự kiện không bao giờ bị bỏ, chỉ để người trực thấy cái nào kẹt.
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")
  /// Giờ hẹn phát / thử lại: bên nghe ném thì lùi dần (10 giây × 2^n, trần 1 giờ), để sự kiện hỏng
  /// không chặn sự kiện mới. Đặt về now() bằng tay là phát lại ngay.
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  /// Hạn giữ của bộ phát đang xử lô (FOR UPDATE SKIP LOCKED): tiến trình chết giữa lượt thì quá hạn
  /// là lô được nhận lại — bên nghe vốn phải idempotent.
  lockedUntil   DateTime? @map("locked_until") @db.Timestamptz(3)

  @@index([nextAttemptAt], where: raw("published_at IS NULL"), map: "outbox_events_due_idx")
  @@map("outbox_events")
}

/// Nhật ký thao tác ghi của master và staff (TK cam kết 3, 31): hạ tầng dùng chung như outbox —
/// module ghi qua `appendAudit(tx, …)` trong transaction của mình, `platform` sở hữu cửa đọc.
/// Trigger tay (migration init_platform_category, viết lại ở add_data_retention): audit_log_immutable chặn DELETE luôn
/// luôn; UPDATE chỉ khi `current_setting('ghim.anonymize', true) = 'on'` và chỉ `target_id`, `details` đổi — đường ẩn
/// danh hoá gậy của `ops` (`pseudonymizeAudit`), mọi cột khác bất biến.
model AuditLog {
  id         String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  actorId    String      @map("actor_id") @db.Uuid
  actorRole  AccountRole @map("actor_role")
  /// `<module>.<đối tượng>.<việc>` — vd `identity.account.lock`.
  action     String
  targetType String      @map("target_type")
  targetId   String      @map("target_id")
  reason     String?
  /// Chỉ mã (mã tin, phiên bản…), không bao giờ tiêu đề, mô tả, giá, ảnh của tin.
  details    Json?       @db.JsonB
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([actorId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([createdAt])
  @@map("audit_log")
}

// ── PLATFORM: ENUM ───────────────────────────────────────────────────────────────────────────────

enum StaffScope {
  support
  user_reports
  id_verification

  @@map("staff_scope")
}

enum StaffPermissionStatus {
  active
  suspended

  @@map("staff_permission_status")
}

// ── PLATFORM: BẢNG ───────────────────────────────────────────────────────────────────────────────

/// CHECK tay (migration init_platform_category):
///   staff_permissions_suspended_at_check:     (status = 'suspended') = (suspended_at IS NOT NULL)
///   staff_permissions_suspended_reason_check: (status = 'suspended') = (suspended_reason IS NOT NULL)
model StaffPermission {
  accountId       String                @id @map("account_id") @db.Uuid
  /// Ba việc toàn hệ thống (TK 5); phạm vi theo danh mục nằm ở `staff_category_grants`.
  scopes          StaffScope[]
  status          StaffPermissionStatus @default(active)
  suspendedReason String?               @map("suspended_reason")
  suspendedAt     DateTime?             @map("suspended_at") @db.Timestamptz(3)
  grantedBy       String                @map("granted_by") @db.Uuid
  grantedAt       DateTime              @map("granted_at") @db.Timestamptz(3)
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  account    Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  categories StaffCategoryGrant[]

  @@map("staff_permissions")
}

model StaffCategoryGrant {
  accountId  String @map("account_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid

  permission StaffPermission @relation(fields: [accountId], references: [accountId], onDelete: Cascade)
  category   Category        @relation(fields: [categoryId], references: [id])

  @@id([accountId, categoryId])
  @@index([categoryId])
  @@map("staff_category_grants")
}

/// CHECK tay (migration init_platform_category): config_versions_version_check: version >= 1
model ConfigVersion {
  version   Int      @id
  /// Toàn bộ khoá của registry `config-keys.ts` → giá trị; một phiên bản là một bộ đầy đủ.
  values    Json     @db.JsonB
  note      String?
  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("config_versions")
}

/// Một chủ đề trợ giúp (add-help-content): master soạn trên bàn vận hành, ai cũng đọc, kể cả khách. Câu hỏi / đáp nằm trong
/// `faqs` (mảng `{ q, a }`) — chủ đề luôn được đọc và sửa cả một lượt. `position` xếp chủ đề, nhỏ trước.
model HelpTopic {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  label     String
  position  Int
  faqs      Json
  updatedAt DateTime @map("updated_at") @db.Timestamptz(3)

  @@index([position])
  @@map("help_topics")
}

