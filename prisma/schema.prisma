// ── CATEGORY: BẢNG ───────────────────────────────────────────────────────────────────────────────

/// CHECK tay (migration init_platform_category):
///   categories_settings_version_check: settings_version >= 1
///   categories_template_version_check: template_version IS NULL OR template_version >= 1
model Category {
  id              String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name            String         @unique
  status          CategoryStatus @default(active)
  /// Trỏ vào dòng hiện hành của `category_setting_versions`; mỗi lần đổi cài đặt tăng một.
  settingsVersion Int            @default(1) @map("settings_version")
  /// Null = chưa phát hành mẫu nào.
  templateVersion Int?           @map("template_version")
  createdBy       String         @map("created_by") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  settingVersions    CategorySettingVersion[]
  templateVersions   TemplateVersion[]
  draft              TemplateDraft?
  staffGrants        StaffCategoryGrant[]
  listings           Listing[]
  savedSearches      SavedSearch[]
  screeningOverrides ScreeningRuleOverride[]
  screeningBands     ScreeningCategoryBand?
  priceStats         CategoryPriceStat?
  keywords           CategoryKeyword[]

  @@map("categories")
}

/// CHECK tay (migration init_platform_category):
///   category_setting_versions_price_cap_check:       price_cap IS NULL OR price_cap >= 0
///   category_setting_versions_reference_price_check: reference_price IS NULL OR reference_price >= 0
///   category_setting_versions_reference_le_cap_check: price_cap IS NULL OR reference_price IS NULL OR reference_price <= price_cap
model CategorySettingVersion {
  categoryId     String      @map("category_id") @db.Uuid
  version        Int
  /// Đồng, BigInt; null = không trần (TK 11, chốt 10/10/2026).
  priceCap       BigInt?     @map("price_cap")
  referencePrice BigInt?     @map("reference_price")
  riskLevel      RiskLevel   @default(low) @map("risk_level")
  alwaysManual   Boolean     @default(false) @map("always_manual")
  groupReview    GroupReview @default(group) @map("group_review")
  changedBy      String      @map("changed_by") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([categoryId, version])
  @@map("category_setting_versions")
}

/// CHECK tay (migration init_platform_category): template_drafts_draft_version_check: draft_version >= 1
model TemplateDraft {
  categoryId   String   @id @map("category_id") @db.Uuid
  /// Mảng mục `{ name, label, type, required, options? }` — kiểm bằng Zod lúc ghi.
  fields       Json     @db.JsonB
  /// Khoá lạc quan: hai người cùng sửa thì người sau nhận 409 và tải lại.
  draftVersion Int      @default(1) @map("draft_version")
  updatedBy    String   @map("updated_by") @db.Uuid
  updatedAt    DateTime @map("updated_at") @db.Timestamptz(3)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@map("template_drafts")
}

/// Bất biến sau khi phát hành: không có route ghi, tin đăng giữ số phiên bản này mãi (TK 11).
model TemplateVersion {
  categoryId  String   @map("category_id") @db.Uuid
  version     Int
  fields      Json     @db.JsonB
  publishedBy String   @map("published_by") @db.Uuid
  publishedAt DateTime @map("published_at") @db.Timestamptz(3)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([categoryId, version])
  @@map("template_versions")
}

/// Mã số chính thức (provinces.open-api.vn) — ổn định cho `listing` tham chiếu; tên cũ và tên gọi
/// tắt biên soạn tay từ hệ thống cũ. `search_text` = mọi tên đã bỏ dấu, để tìm bằng LIKE.
model Province {
  code        Int      @id
  name        String
  fullName    String   @map("full_name")
  formerNames String[] @map("former_names")
  aliases     String[]
  searchText  String   @map("search_text")

  wards    Ward[]
  listings Listing[]
  homeOf   Account[]

  @@map("provinces")
}

model Ward {
  code         Int      @id
  provinceCode Int      @map("province_code")
  name         String
  /// Chưa có nguồn dữ liệu (10/10/2026): cột có sẵn, bổ sung dần bằng script sinh.
  formerNames  String[] @map("former_names")
  searchText   String   @map("search_text")

  province Province  @relation(fields: [provinceCode], references: [code])
  listings Listing[]

  @@unique([provinceCode, name])
  @@index([provinceCode])
  @@map("wards")
}

// ── GROUP: ENUM ──────────────────────────────────────────────────────────────────────────────────

/// Loại nhóm chỉ để chọn sẵn cài đặt lúc lập (TK 9); trường học và công ty có đơn vị con.
enum GroupKind {
  school
  company
  community
  other

  @@map("group_kind")
}

enum GroupState {
  pending_owner
  active
  going_private
  ownerless
  locked
  closed

  @@map("group_state")
}

/// "Riêng tư · mở cửa" cố ý không có (TK 9).
enum GroupMode {
  public_open
  public_review
  private_code
  private_invite

  @@map("group_mode")
}

enum GroupBoardStyle {
