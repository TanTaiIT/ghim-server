// Quy ước trong file này:
//   - Tên bảng/cột trong DB là snake_case (@map/@@map), code đọc camelCase.
//   - Thời điểm luôn timestamptz. Postgres lưu mốc tuyệt đối, việc đổi sang Asia/Ho_Chi_Minh
//     là của tầng hiển thị — lưu `timestamp` trần là mất múi giờ ngay lúc ghi.
//   - Giá là BigInt, đơn vị ĐỒNG, không âm; 0 = cho tặng. Không Float.
//   - Id uuid v7 do Postgres 18 sinh (`uuidv7()`): tăng theo thời gian nên index ghi dồn về cuối
//     thay vì rải ngẫu nhiên như v4.
//   - KHÔNG multi-tenant: một sàn dùng chung. Phạm vi xem theo nhóm là luật nghiệp vụ của module
//     `listing`, không phải cách ly dữ liệu như `shop_id` của booking.
//   - Trạng thái tin, cờ tạm ẩn và lý do hạn chế hiển thị là BA cột riêng — gộp làm một là lặp lại
//     lỗi "Đã ẩn" của hệ thống cũ (THIET-KE-HE-THONG.md phần 4, 15, 19).
//   - CHECK viết tay nằm trong migration; model nào có CHECK thì ghi `///` ngay trên model, tên
//     constraint trùng tên trong SQL để `pnpm db:drift` và người đọc đối chiếu được.
//   - Cột "ai làm" (`locked_by`, `cleared_by`, `reviewed_by`, `removed_by`) là uuid trần, không FK:
//     nhật ký phải còn nguyên khi tài khoản người làm bị xoá hẳn.

generator client {
  provider        = "prisma-client-js"
  // Khai được index có WHERE ngay trong schema (Prisma ≥ 7.4) — thiếu cờ này thì index viết tay
  // trong SQL bị `migrate dev` coi là lệch và tự sinh lệnh DROP ở migration kế tiếp.
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ── IDENTITY: ENUM ───────────────────────────────────────────────────────────────────────────────

enum AccountStatus {
  pending_verification
  active
  locked
  deleted

  @@map("account_status")
}

enum AccountRole {
  user
  master

  @@map("account_role")
}

enum CodePurpose {
  email_verify
  password_reset
  email_change

  @@map("code_purpose")
}

enum SessionRevokeReason {
  logout
  evicted
  password_changed
  password_reset
  revoked_by_user
  account_locked
  account_deleted
  refresh_reuse

  @@map("session_revoke_reason")
}

enum AccountFlagKind {
  many_accounts_on_device
  device_of_locked_account

  @@map("account_flag_kind")
}

enum DisposableDomainSource {
  seed
  manual

  @@map("disposable_domain_source")
}

enum IdVerificationStatus {
  pending
  verified
  rejected

  @@map("id_verification_status")
}

// ── IDENTITY: BẢNG ───────────────────────────────────────────────────────────────────────────────

/// CHECK tay (migration init_identity):
///   accounts_credential_check: password_hash IS NOT NULL OR google_sub IS NOT NULL
///   accounts_locked_check:     (status = 'locked')  = (locked_at IS NOT NULL)
///   accounts_deleted_check:    (status = 'deleted') = (deleted_at IS NOT NULL)
model Account {
  id                String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Email như người dùng gõ — chỉ để gửi thư. So trùng luôn dùng `emailNormalized`.
  email             String
  emailNormalized   String        @unique @map("email_normalized")
  /// HMAC-SHA256 với `IDENTITY_HASH_KEY`: `trust` nối gậy qua lần đăng ký lại mà không giữ email.
  emailHash         String        @map("email_hash")
  passwordHash      String?       @map("password_hash")
  googleSub         String?       @unique @map("google_sub")
  status            AccountStatus @default(pending_verification)
  role              AccountRole   @default(user)
  displayName       String        @map("display_name")
  avatarUrl         String?       @map("avatar_url")
  phone             String?
  totpSecretEnc     String?       @map("totp_secret_enc")
  totpEnabledAt     DateTime?     @map("totp_enabled_at") @db.Timestamptz(3)
  lockedReason      String?       @map("locked_reason")
  lockedAt          DateTime?     @map("locked_at") @db.Timestamptz(3)
  lockedBy          String?       @map("locked_by") @db.Uuid
  deletedAt         DateTime?     @map("deleted_at") @db.Timestamptz(3)
  emailChangedAt    DateTime?     @map("email_changed_at") @db.Timestamptz(3)
  passwordChangedAt DateTime?     @map("password_changed_at") @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  verificationCodes VerificationCode[]
  sessions          Session[]
  devicePosts       DevicePost[]
  deviceClearances  DeviceClearance[]
  flags             AccountFlag[]
  idVerifications   IdVerification[]
  staffPermission   StaffPermission?
  groupMemberships  GroupMember[]
  groupBans         GroupBan[]
  groupJoinRequests GroupJoinRequest[]
  groupInvitations  GroupInvitation[]
  groupOwnerOffers  GroupOwnerOffer[]
  notifications     Notification[]
  notificationPrefs NotificationPreference[]
  groupMutes        GroupNotificationMute[]

  @@index([emailHash])
  @@index([status, createdAt])
  @@index([status, deletedAt])
  @@map("accounts")
}

/// CHECK tay (migration init_identity):
///   verification_codes_attempts_check: attempts >= 0
///   verification_codes_target_check:   purpose <> 'email_change' OR target_email IS NOT NULL
model VerificationCode {
  id          String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  accountId   String      @map("account_id") @db.Uuid
  purpose     CodePurpose
  /// DB chỉ giữ HMAC của mã: lộ bảng không lộ mã đang sống.
  codeHash    String      @map("code_hash")
  /// Chỉ `email_change` có: email mới đang chờ xác nhận, email cũ vẫn là email đăng nhập.
  targetEmail String?     @map("target_email")
  attempts    Int         @default(0)
  expiresAt   DateTime    @map("expires_at") @db.Timestamptz(3)
  consumedAt  DateTime?   @map("consumed_at") @db.Timestamptz(3)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  // Một mã sống mỗi mục đích: xin mã mới = đánh dấu consumed_at cho mã cũ rồi tạo mã mới trong
  // cùng transaction. DB là chốt cuối, service không được coi kiểm trước là đủ.
  @@unique([accountId, purpose], where: raw("consumed_at IS NULL"), map: "verification_codes_live_key")
  @@map("verification_codes")
}

/// CHECK tay (migration init_identity):
///   sessions_revoke_check: (revoked_at IS NULL) = (revoke_reason IS NULL)
model Session {
  id                   String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  accountId            String               @map("account_id") @db.Uuid
  /// SHA-256 của refresh token; token thật chỉ nằm ở thiết bị. Xoay mỗi lần refresh.
  refreshTokenHash     String               @unique @map("refresh_token_hash")
  /// Băm của token vừa bị xoay: ai dùng lại nó là token đã lộ → thu hồi cả phiên (design 4).
  prevRefreshTokenHash String?              @map("prev_refresh_token_hash")
  deviceName           String               @map("device_name")
  ip                   String?
  userAgent            String?              @map("user_agent")
  /// Có giá trị = phiên này đã qua lớp thứ hai; `requireOps` từ chối phiên thiếu nó.
  secondFactorAt       DateTime?            @map("second_factor_at") @db.Timestamptz(3)
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  lastActiveAt         DateTime             @default(now()) @map("last_active_at") @db.Timestamptz(3)
  /// Hết hạn trượt: last_active_at + 30 ngày (giá trị khởi đầu), cập nhật khi refresh.
  expiresAt            DateTime             @map("expires_at") @db.Timestamptz(3)
  revokedAt            DateTime?            @map("revoked_at") @db.Timestamptz(3)
  revokeReason         SessionRevokeReason? @map("revoke_reason")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  // Đếm phiên đang sống và tìm phiên ít hoạt động nhất để đẩy ra — một index phục vụ cả hai.
  @@index([accountId, revokedAt, lastActiveAt])
  @@index([prevRefreshTokenHash])
  /// Hai index cho việc dọn phiên hằng đêm (`revoked_at < x OR expires_at < x`): Postgres gộp bằng
  /// BitmapOr thay vì quét cả bảng. `refresh_token_hash` vốn đổi mỗi lần làm mới nên lượt ghi đó
  /// đã cập nhật index — thêm `expires_at` chỉ thêm một index, không làm mất HOT update.
  @@index([expiresAt])
  @@index([revokedAt], where: raw("revoked_at IS NOT NULL"), map: "sessions_revoked_idx")
  @@map("sessions")
}

/// CHECK tay (migration init_identity):
///   device_posts_order_check: last_posted_at >= first_posted_at
model DevicePost {
  /// HMAC của mã thiết bị app gửi lên; mã thật không bao giờ vào DB hay response.
  deviceHash    String   @map("device_hash")
  accountId     String   @map("account_id") @db.Uuid
  firstPostedAt DateTime @map("first_posted_at") @db.Timestamptz(3)
  lastPostedAt  DateTime @map("last_posted_at") @db.Timestamptz(3)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([deviceHash, accountId])
  @@index([accountId])
  @@map("device_posts")
}

model DeviceClearance {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  deviceHash String   @map("device_hash")
  accountId  String   @map("account_id") @db.Uuid
  clearedAt  DateTime @default(now()) @map("cleared_at") @db.Timestamptz(3)
  clearedBy  String   @map("cleared_by") @db.Uuid
  reason     String

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([deviceHash, accountId])
  @@map("device_clearances")
}

/// CHECK tay (migration init_identity):
///   account_flags_cleared_check: (cleared_at IS NULL) = (cleared_reason IS NULL)
///   account_flags_related_check: kind <> 'device_of_locked_account' OR related_account_id IS NOT NULL
model AccountFlag {
  id               String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  accountId        String          @map("account_id") @db.Uuid
  kind             AccountFlagKind
  deviceHash       String          @map("device_hash")
  /// Tài khoản bị khoá mà đánh dấu `device_of_locked_account` nói tới; uuid trần vì chỉ để tra
  /// cứu, không FK — tài khoản kia bị xoá hẳn thì đánh dấu vẫn còn đọc được.
  relatedAccountId String?         @map("related_account_id") @db.Uuid
  /// 8 ký tự Crockford base32 từ 5 byte ngẫu nhiên: không mang thông tin gì về loại, tài khoản
  /// hay thiết bị — người dùng chỉ đưa mã này cho hỗ trợ.
  lookupCode       String          @unique @map("lookup_code")
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  clearedAt        DateTime?       @map("cleared_at") @db.Timestamptz(3)
  clearedBy        String?         @map("cleared_by") @db.Uuid
  clearedReason    String?         @map("cleared_reason")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, kind, deviceHash], where: raw("cleared_at IS NULL"), map: "account_flags_open_key")
  @@index([accountId])
  @@map("account_flags")
}

model DisposableDomain {
  domain    String                 @id
  source    DisposableDomainSource
  addedAt   DateTime               @default(now()) @map("added_at") @db.Timestamptz(3)
  /// Bia mộ: master bỏ một miền thì giữ dòng với removed_at để lượt cập nhật tự động không
  /// hồi sinh nó (INSERT … ON CONFLICT DO NOTHING vấp dòng này).
  removedAt DateTime?              @map("removed_at") @db.Timestamptz(3)
  removedBy String?                @map("removed_by") @db.Uuid

  @@map("disposable_domains")
}

/// CHECK tay (migration init_identity):
///   id_verifications_reason_check: status <> 'rejected' OR reason IS NOT NULL
model IdVerification {
  id                String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  accountId         String               @map("account_id") @db.Uuid
  documentType      String               @map("document_type")
  /// AES-256-GCM bằng `SECRETS_ENCRYPTION_KEY`; không response nào trả số giấy tờ.
  documentNumberEnc String               @map("document_number_enc")
  fullName          String               @map("full_name")
  status            IdVerificationStatus @default(pending)
  reviewedBy        String?              @map("reviewed_by") @db.Uuid
  reviewedAt        DateTime?            @map("reviewed_at") @db.Timestamptz(3)
  reason            String?
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId], where: raw("status = 'pending'"), map: "id_verifications_pending_key")
  @@map("id_verifications")
}

// ── HẠ TẦNG DÙNG CHUNG ───────────────────────────────────────────────────────────────────────────

/// Không module nghiệp vụ nào sở hữu (như `_prisma_migrations`): module ghi qua
/// `appendEvents(tx, …)` trong cùng transaction với thay đổi gốc; bộ phát tối thiểu ở
/// `src/common/outbox/dispatcher.ts` đọc, gọi bên nghe, đánh dấu `published_at`; `ops` nhận lại sau.
model OutboxEvent {
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  type          String
  payload       Json      @db.JsonB
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(3)
  /// Số lần bên nghe ném; sự kiện không bao giờ bị bỏ, chỉ để người trực thấy cái nào kẹt.
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")
  /// Giờ hẹn phát / thử lại: bên nghe ném thì lùi dần (10 giây × 2^n, trần 1 giờ), để sự kiện hỏng
  /// không chặn sự kiện mới. Đặt về now() bằng tay là phát lại ngay.
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  /// Hạn giữ của bộ phát đang xử lô (FOR UPDATE SKIP LOCKED): tiến trình chết giữa lượt thì quá hạn
  /// là lô được nhận lại — bên nghe vốn phải idempotent.
  lockedUntil   DateTime? @map("locked_until") @db.Timestamptz(3)

  @@index([nextAttemptAt], where: raw("published_at IS NULL"), map: "outbox_events_due_idx")
  @@map("outbox_events")
}

/// Nhật ký thao tác ghi của master và staff (TK cam kết 3, 31): hạ tầng dùng chung như outbox —
/// module ghi qua `appendAudit(tx, …)` trong transaction của mình, `platform` sở hữu cửa đọc.
/// Trigger tay (migration init_platform_category): audit_log_immutable chặn UPDATE / DELETE.
model AuditLog {
  id         String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  actorId    String      @map("actor_id") @db.Uuid
  actorRole  AccountRole @map("actor_role")
  /// `<module>.<đối tượng>.<việc>` — vd `identity.account.lock`.
  action     String
  targetType String      @map("target_type")
  targetId   String      @map("target_id")
  reason     String?
  /// Chỉ mã (mã tin, phiên bản…), không bao giờ tiêu đề, mô tả, giá, ảnh của tin.
  details    Json?       @db.JsonB
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([actorId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([createdAt])
  @@map("audit_log")
}

// ── PLATFORM: ENUM ───────────────────────────────────────────────────────────────────────────────

enum StaffScope {
  support
  user_reports
  id_verification

  @@map("staff_scope")
}

enum StaffPermissionStatus {
  active
  suspended

  @@map("staff_permission_status")
}

// ── PLATFORM: BẢNG ───────────────────────────────────────────────────────────────────────────────

/// CHECK tay (migration init_platform_category):
///   staff_permissions_suspended_at_check:     (status = 'suspended') = (suspended_at IS NOT NULL)
///   staff_permissions_suspended_reason_check: (status = 'suspended') = (suspended_reason IS NOT NULL)
model StaffPermission {
  accountId       String                @id @map("account_id") @db.Uuid
  /// Ba việc toàn hệ thống (TK 5); phạm vi theo danh mục nằm ở `staff_category_grants`.
  scopes          StaffScope[]
  status          StaffPermissionStatus @default(active)
  suspendedReason String?               @map("suspended_reason")
  suspendedAt     DateTime?             @map("suspended_at") @db.Timestamptz(3)
  grantedBy       String                @map("granted_by") @db.Uuid
  grantedAt       DateTime              @map("granted_at") @db.Timestamptz(3)
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  account    Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  categories StaffCategoryGrant[]

  @@map("staff_permissions")
}

model StaffCategoryGrant {
  accountId  String @map("account_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid

  permission StaffPermission @relation(fields: [accountId], references: [accountId], onDelete: Cascade)
  category   Category        @relation(fields: [categoryId], references: [id])

  @@id([accountId, categoryId])
  @@index([categoryId])
  @@map("staff_category_grants")
}

/// CHECK tay (migration init_platform_category): config_versions_version_check: version >= 1
model ConfigVersion {
  version   Int      @id
  /// Toàn bộ khoá của registry `config-keys.ts` → giá trị; một phiên bản là một bộ đầy đủ.
  values    Json     @db.JsonB
  note      String?
  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("config_versions")
}

// ── CATEGORY: ENUM ───────────────────────────────────────────────────────────────────────────────

enum CategoryStatus {
  active
  disabled

  @@map("category_status")
}

enum RiskLevel {
  low
  medium
  high

  @@map("risk_level")
}

enum GroupReview {
  group
  platform

  @@map("group_review")
}

// ── CATEGORY: BẢNG ───────────────────────────────────────────────────────────────────────────────

/// CHECK tay (migration init_platform_category):
///   categories_settings_version_check: settings_version >= 1
///   categories_template_version_check: template_version IS NULL OR template_version >= 1
model Category {
  id              String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name            String         @unique
  status          CategoryStatus @default(active)
  /// Trỏ vào dòng hiện hành của `category_setting_versions`; mỗi lần đổi cài đặt tăng một.
  settingsVersion Int            @default(1) @map("settings_version")
  /// Null = chưa phát hành mẫu nào.
  templateVersion Int?           @map("template_version")
  createdBy       String         @map("created_by") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  settingVersions  CategorySettingVersion[]
  templateVersions TemplateVersion[]
  draft            TemplateDraft?
  staffGrants      StaffCategoryGrant[]

  @@map("categories")
}

/// CHECK tay (migration init_platform_category):
///   category_setting_versions_price_cap_check:       price_cap IS NULL OR price_cap >= 0
///   category_setting_versions_reference_price_check: reference_price IS NULL OR reference_price >= 0
///   category_setting_versions_reference_le_cap_check: price_cap IS NULL OR reference_price IS NULL OR reference_price <= price_cap
model CategorySettingVersion {
  categoryId     String      @map("category_id") @db.Uuid
  version        Int
  /// Đồng, BigInt; null = không trần (TK 11, chốt 10/10/2026).
  priceCap       BigInt?     @map("price_cap")
  referencePrice BigInt?     @map("reference_price")
  riskLevel      RiskLevel   @default(low) @map("risk_level")
  alwaysManual   Boolean     @default(false) @map("always_manual")
  groupReview    GroupReview @default(group) @map("group_review")
  changedBy      String      @map("changed_by") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([categoryId, version])
  @@map("category_setting_versions")
}

/// CHECK tay (migration init_platform_category): template_drafts_draft_version_check: draft_version >= 1
model TemplateDraft {
  categoryId   String   @id @map("category_id") @db.Uuid
  /// Mảng mục `{ name, label, type, required, options? }` — kiểm bằng Zod lúc ghi.
  fields       Json     @db.JsonB
  /// Khoá lạc quan: hai người cùng sửa thì người sau nhận 409 và tải lại.
  draftVersion Int      @default(1) @map("draft_version")
  updatedBy    String   @map("updated_by") @db.Uuid
  updatedAt    DateTime @map("updated_at") @db.Timestamptz(3)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@map("template_drafts")
}

/// Bất biến sau khi phát hành: không có route ghi, tin đăng giữ số phiên bản này mãi (TK 11).
model TemplateVersion {
  categoryId  String   @map("category_id") @db.Uuid
  version     Int
  fields      Json     @db.JsonB
  publishedBy String   @map("published_by") @db.Uuid
  publishedAt DateTime @map("published_at") @db.Timestamptz(3)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([categoryId, version])
  @@map("template_versions")
}

/// Mã số chính thức (provinces.open-api.vn) — ổn định cho `listing` tham chiếu; tên cũ và tên gọi
/// tắt biên soạn tay từ hệ thống cũ. `search_text` = mọi tên đã bỏ dấu, để tìm bằng LIKE.
model Province {
  code        Int      @id
  name        String
  fullName    String   @map("full_name")
  formerNames String[] @map("former_names")
  aliases     String[]
  searchText  String   @map("search_text")

  wards Ward[]

  @@map("provinces")
}

model Ward {
  code         Int      @id
  provinceCode Int      @map("province_code")
  name         String
  /// Chưa có nguồn dữ liệu (10/10/2026): cột có sẵn, bổ sung dần bằng script sinh.
  formerNames  String[] @map("former_names")
  searchText   String   @map("search_text")

  province Province @relation(fields: [provinceCode], references: [code])

  @@unique([provinceCode, name])
  @@index([provinceCode])
  @@map("wards")
}

// ── GROUP: ENUM ──────────────────────────────────────────────────────────────────────────────────

/// Loại nhóm chỉ để chọn sẵn cài đặt lúc lập (TK 9); trường học và công ty có đơn vị con.
enum GroupKind {
  school
  company
  community
  other

  @@map("group_kind")
}

enum GroupState {
  pending_owner
  active
  going_private
  ownerless
  locked
  closed

  @@map("group_state")
}

/// "Riêng tư · mở cửa" cố ý không có (TK 9).
enum GroupMode {
  public_open
  public_review
  private_code
  private_invite

  @@map("group_mode")
}

enum GroupBoardStyle {
  list
  grid

  @@map("group_board_style")
}

/// Khoá do hệ thống (thiếu chủ quá hạn, hết điều hành viên) tự mở khi có chủ dùng được; khoá do master thì không.
enum GroupLockCause {
  master
  ownerless_timeout
  no_moderators

  @@map("group_lock_cause")
}

enum GroupRole {
  member
  moderator
  owner

  @@map("group_role")
}

/// Đường vào quyết định huy hiệu và không đổi về sau (TK 10).
enum GroupJoinPath {
  joined
  approved
  invited
  roster
  assigned

  @@map("group_join_path")
}

enum GroupJoinRequestStatus {
  pending
  approved
  rejected
  expired
  withdrawn
  cancelled

  @@map("group_join_request_status")
}

enum GroupInvitationStatus {
  pending
  accepted
  declined
  expired
  revoked
  cancelled

  @@map("group_invitation_status")
}

enum GroupOwnerOfferKind {
  assignment
  transfer

  @@map("group_owner_offer_kind")
}

enum GroupOwnerOfferStatus {
  pending
  accepted
  declined
  expired
  cancelled

  @@map("group_owner_offer_status")
}

// ── GROUP: BẢNG ──────────────────────────────────────────────────────────────────────────────────

/// CHECK viết tay: groups_locked_check (khoá thì có thời điểm và nguyên nhân), groups_master_lock_reason_check
/// (master khoá thì có lý do), groups_closed_check, groups_ownerless_check, groups_going_private_check
/// (`target_mode` chỉ khi đang chuyển), groups_outsiders_check (chỉ nhóm công khai), groups_show_name_check
/// (chỉ nhóm riêng tư), groups_code_check (có mã ⇔ riêng tư · có mã và chưa đóng).
model Group {
  id                    String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name                  String
  /// `fold(name)` — tìm không dấu bằng LIKE, như `search_text` của khu vực.
  nameFolded            String          @map("name_folded")
  description           String?
  kind                  GroupKind
  state                 GroupState      @default(pending_owner)
  mode                  GroupMode
  /// Chế độ riêng tư đang chuyển tới, chỉ khi `state = 'going_private'`.
  targetMode            GroupMode?      @map("target_mode")
  allowOutsiders        Boolean         @default(false) @map("allow_outsiders")
  showNameOnMarketplace Boolean         @default(false) @map("show_name_on_marketplace")
  boardStyle            GroupBoardStyle @default(list) @map("board_style")
  code                  String?         @unique
  ownerlessSince        DateTime?       @map("ownerless_since") @db.Timestamptz(3)
  nomineeId             String?         @map("nominee_id") @db.Uuid
  lockedAt              DateTime?       @map("locked_at") @db.Timestamptz(3)
  lockCause             GroupLockCause? @map("lock_cause")
  lockedReason          String?         @map("locked_reason")
  lockedBy              String?         @map("locked_by") @db.Uuid
  closedAt              DateTime?       @map("closed_at") @db.Timestamptz(3)
  closedBy              String?         @map("closed_by") @db.Uuid
  createdBy             String          @map("created_by") @db.Uuid
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  units         GroupUnit[]
  members       GroupMember[]
  bans          GroupBan[]
  joinRequests  GroupJoinRequest[]
  invitations   GroupInvitation[]
  rosterEntries GroupRosterEntry[]
  ownerOffers   GroupOwnerOffer[]
  announcements GroupAnnouncement[]
  mutes         GroupNotificationMute[]

  @@index([state, mode])
  @@index([ownerlessSince], where: raw("state = 'ownerless'"), map: "groups_ownerless_idx")
  @@map("groups")
}

/// `(group_id, id)` unique là đích của khoá ngoại ghép: thành viên chỉ thuộc được đơn vị của chính nhóm mình.
model GroupUnit {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  groupId   String   @map("group_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  group      Group         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  members    GroupMember[] @relation("member_unit")
  moderators GroupMember[] @relation("moderator_unit")

  @@unique([groupId, name])
  @@unique([groupId, id])
  @@map("group_units")
}

/// Chủ nhóm là một dòng ở đây với `role = 'owner'` — một nguồn duy nhất. CHECK viết tay:
/// group_members_moderator_unit_check (`moderator_unit_id` chỉ khi là điều hành viên),
/// group_members_role_since_check (có vai thì có lúc nhận vai).
model GroupMember {
  groupId         String        @map("group_id") @db.Uuid
  accountId       String        @map("account_id") @db.Uuid
  role            GroupRole     @default(member)
  /// Phạm vi của điều hành viên; null = cả nhóm.
  moderatorUnitId String?       @map("moderator_unit_id") @db.Uuid
  unitId          String?       @map("unit_id") @db.Uuid
  joinedVia       GroupJoinPath @map("joined_via")
  joinedAt        DateTime      @map("joined_at") @db.Timestamptz(3)
  /// Lúc nhận vai hiện tại — đề cử thiếu chủ xếp theo cột này.
  roleSince       DateTime?     @map("role_since") @db.Timestamptz(3)

  group         Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  account       Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  unit          GroupUnit? @relation("member_unit", fields: [groupId, unitId], references: [groupId, id], onDelete: Restrict)
  moderatorUnit GroupUnit? @relation("moderator_unit", fields: [groupId, moderatorUnitId], references: [groupId, id], onDelete: Restrict)

  @@id([groupId, accountId])
  @@unique([groupId], where: raw("role = 'owner'"), map: "group_members_one_owner_key")
  @@index([accountId])
  @@map("group_members")
}

model GroupBan {
  groupId   String   @map("group_id") @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  bannedBy  String   @map("banned_by") @db.Uuid
  bannedAt  DateTime @map("banned_at") @db.Timestamptz(3)

  group   Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([groupId, accountId])
  @@map("group_bans")
}

/// CHECK viết tay: group_join_requests_decided_check (đơn chờ chưa có lúc xử, đơn đã xử thì có).
model GroupJoinRequest {
  id        String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  groupId   String                 @map("group_id") @db.Uuid
  accountId String                 @map("account_id") @db.Uuid
  status    GroupJoinRequestStatus @default(pending)
  createdAt DateTime               @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime               @map("expires_at") @db.Timestamptz(3)
  decidedAt DateTime?              @map("decided_at") @db.Timestamptz(3)
  decidedBy String?                @map("decided_by") @db.Uuid

  group   Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([groupId, accountId], where: raw("status = 'pending'"), map: "group_join_requests_pending_key")
  @@index([accountId, status])
  @@index([groupId, status, createdAt])
  @@index([expiresAt], where: raw("status = 'pending'"), map: "group_join_requests_due_idx")
  @@map("group_join_requests")
}

/// `unit_id` không khoá ngoại: xoá đơn vị thì service gỡ đơn vị khỏi lời mời trong cùng transaction.
/// CHECK viết tay: group_invitations_decided_check.
model GroupInvitation {
  id        String                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  groupId   String                @map("group_id") @db.Uuid
  accountId String                @map("account_id") @db.Uuid
  unitId    String?               @map("unit_id") @db.Uuid
  invitedBy String                @map("invited_by") @db.Uuid
  status    GroupInvitationStatus @default(pending)
  createdAt DateTime              @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime              @map("expires_at") @db.Timestamptz(3)
  decidedAt DateTime?             @map("decided_at") @db.Timestamptz(3)

  group   Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([groupId, accountId], where: raw("status = 'pending'"), map: "group_invitations_pending_key")
  @@index([accountId, status])
  @@index([expiresAt], where: raw("status = 'pending'"), map: "group_invitations_due_idx")
  @@map("group_invitations")
}

/// Danh sách lớp: chỉ dấu băm HMAC của email đã chuẩn hoá — cùng khoá với `accounts.email_hash`, nên khớp
/// người mà không giữ email thô (TK 10).
model GroupRosterEntry {
  groupId   String   @map("group_id") @db.Uuid
  emailHash String   @map("email_hash")
  unitId    String?  @map("unit_id") @db.Uuid
  addedBy   String   @map("added_by") @db.Uuid
  addedAt   DateTime @map("added_at") @db.Timestamptz(3)

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([groupId, emailHash])
  @@index([emailHash])
  @@map("group_roster_entries")
}

/// Ba đường giao chủ chung một bảng: master giao (lần đầu, nhóm thiếu chủ, giao đè) và chủ chuyển nhượng.
/// CHECK viết tay: group_owner_offers_decided_check.
model GroupOwnerOffer {
  id            String                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  groupId       String                @map("group_id") @db.Uuid
  kind          GroupOwnerOfferKind
  fromAccountId String?               @map("from_account_id") @db.Uuid
  toAccountId   String                @map("to_account_id") @db.Uuid
  status        GroupOwnerOfferStatus @default(pending)
  createdAt     DateTime              @map("created_at") @db.Timestamptz(3)
  expiresAt     DateTime              @map("expires_at") @db.Timestamptz(3)
  decidedAt     DateTime?             @map("decided_at") @db.Timestamptz(3)

  group     Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  toAccount Account @relation(fields: [toAccountId], references: [id], onDelete: Cascade)

  @@unique([groupId], where: raw("status = 'pending'"), map: "group_owner_offers_pending_key")
  @@index([toAccountId, status])
  @@index([expiresAt], where: raw("status = 'pending'"), map: "group_owner_offers_due_idx")
  @@map("group_owner_offers")
}

/// `unit_id` = phạm vi (null = cả nhóm), không khoá ngoại vì cùng lý do với lời mời.
model GroupAnnouncement {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  groupId   String   @map("group_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  unitId    String?  @map("unit_id") @db.Uuid
  body      String
  createdAt DateTime @map("created_at") @db.Timestamptz(3)

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, createdAt])
  @@map("group_announcements")
}

// ── NOTIFICATION ─────────────────────────────────────────────────────────────────────────────────

/// Chín nhóm thông báo của TK 24, bật tắt được từng nhóm (trừ `account`).
enum NotificationCategory {
  messages
  your_listings
  your_groups
  your_reports
  account
  trust_strikes
  group_announcements
  group_new_listings
  support

  @@map("notification_category")
}

/// Một dòng hộp thư. Văn bản sinh lúc ghi từ mẫu trong code; `detail` chỉ người được xem mới có (vd lý do khoá nhóm
/// cho chủ nhóm) và không bao giờ nằm trong câu nhắc. Dòng gộp (`collapse_key`) được cập nhật thay vì thêm mới khi
/// người nhận chưa đọc; `source_event_id` là sự kiện outbox gần nhất đã áp vào dòng — giao trùng không ghi hai lần.
/// CHECK viết tay: notifications_count_check (`count` >= 1).
model Notification {
  id            String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  recipientId   String               @map("recipient_id") @db.Uuid
  category      NotificationCategory
  type          String
  title         String
  body          String
  detail        String?
  data          Json                 @db.JsonB
  groupId       String?              @map("group_id") @db.Uuid
  collapseKey   String?              @map("collapse_key")
  count         Int                  @default(1)
  alert         Boolean
  alertedAt     DateTime?            @map("alerted_at") @db.Timestamptz(3)
  readAt        DateTime?            @map("read_at") @db.Timestamptz(3)
  sourceEventId String               @map("source_event_id") @db.Uuid
  createdAt     DateTime             @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime             @map("updated_at") @db.Timestamptz(3)

  recipient Account @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([sourceEventId, recipientId])
  @@index([recipientId, updatedAt])
  @@index([recipientId], where: raw("read_at IS NULL"), map: "notifications_unread_idx")
  @@index([recipientId, collapseKey], where: raw("read_at IS NULL AND collapse_key IS NOT NULL"), map: "notifications_collapse_idx")
  @@map("notifications")
}

/// Chỉ lưu nhóm người dùng đã đổi khỏi mặc định (bật); không có dòng = đang bật.
model NotificationPreference {
  accountId String               @map("account_id") @db.Uuid
  category  NotificationCategory
  enabled   Boolean

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([accountId, category])
  @@map("notification_preferences")
}

/// Tắt tiếng một nhóm: thông báo của nhóm vẫn vào hộp thư nhưng không nhắc, trừ chuyện về chính tư cách người đó.
model GroupNotificationMute {
  accountId String   @map("account_id") @db.Uuid
  groupId   String   @map("group_id") @db.Uuid
  createdAt DateTime @map("created_at") @db.Timestamptz(3)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  group   Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([accountId, groupId])
  @@map("group_notification_mutes")
}
