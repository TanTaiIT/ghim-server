  approved
  rejected
  expired
  withdrawn
  cancelled

  @@map("group_join_request_status")
}

enum GroupInvitationStatus {
  pending
  accepted
  declined
  expired
  revoked
  cancelled

  @@map("group_invitation_status")
}

enum GroupOwnerOfferKind {
  assignment
  transfer

  @@map("group_owner_offer_kind")
}

enum GroupOwnerOfferStatus {
  pending
  accepted
  declined
  expired
  cancelled

  @@map("group_owner_offer_status")
}

// ── GROUP: BẢNG ──────────────────────────────────────────────────────────────────────────────────

/// CHECK viết tay: groups_locked_check (khoá thì có thời điểm và nguyên nhân), groups_master_lock_reason_check
/// (master khoá thì có lý do), groups_closed_check, groups_ownerless_check, groups_going_private_check
/// (`target_mode` chỉ khi đang chuyển), groups_outsiders_check (chỉ nhóm công khai), groups_show_name_check
/// (chỉ nhóm riêng tư), groups_code_check (có mã ⇔ riêng tư · có mã và chưa đóng).
model Group {
  id                    String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name                  String
  /// `fold(name)` — tìm không dấu bằng LIKE, như `search_text` của khu vực.
  nameFolded            String          @map("name_folded")
  description           String?
  kind                  GroupKind
  state                 GroupState      @default(pending_owner)
  mode                  GroupMode
  /// Chế độ riêng tư đang chuyển tới, chỉ khi `state = 'going_private'`.
  targetMode            GroupMode?      @map("target_mode")
  allowOutsiders        Boolean         @default(false) @map("allow_outsiders")
  showNameOnMarketplace Boolean         @default(false) @map("show_name_on_marketplace")
  boardStyle            GroupBoardStyle @default(list) @map("board_style")
  code                  String?         @unique
  ownerlessSince        DateTime?       @map("ownerless_since") @db.Timestamptz(3)
  nomineeId             String?         @map("nominee_id") @db.Uuid
  lockedAt              DateTime?       @map("locked_at") @db.Timestamptz(3)
  lockCause             GroupLockCause? @map("lock_cause")
  lockedReason          String?         @map("locked_reason")
  lockedBy              String?         @map("locked_by") @db.Uuid
  closedAt              DateTime?       @map("closed_at") @db.Timestamptz(3)
  closedBy              String?         @map("closed_by") @db.Uuid
  /// Nhóm đóng quá hạn lưu đã được `ops` dọn (tin, thành viên, đơn, lời mời…) — dòng nhóm giữ.
  purgedAt              DateTime?       @map("purged_at") @db.Timestamptz(3)
  createdBy             String          @map("created_by") @db.Uuid
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  units         GroupUnit[]
  members       GroupMember[]
  bans          GroupBan[]
  joinRequests  GroupJoinRequest[]
  invitations   GroupInvitation[]
  rosterEntries GroupRosterEntry[]
  ownerOffers   GroupOwnerOffer[]
  announcements GroupAnnouncement[]
  mutes         GroupNotificationMute[]
  listings      Listing[]               @relation("listing_group")
  badgeListings Listing[]               @relation("listing_badge")
  badgeBlocks   ListingBadgeBlock[]

  @@index([state, mode])
  @@index([ownerlessSince], where: raw("state = 'ownerless'"), map: "groups_ownerless_idx")
  @@index([closedAt], where: raw("state = 'closed' AND purged_at IS NULL"), map: "groups_purge_due_idx")
  @@map("groups")
}

/// `(group_id, id)` unique là đích của khoá ngoại ghép: thành viên chỉ thuộc được đơn vị của chính nhóm mình.
model GroupUnit {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  groupId   String   @map("group_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  group         Group               @relation(fields: [groupId], references: [id], onDelete: Cascade)
  members       GroupMember[]       @relation("member_unit")
  moderators    GroupMember[]       @relation("moderator_unit")
  announcements GroupAnnouncement[]

  @@unique([groupId, name])
  @@unique([groupId, id])
  @@map("group_units")
}

/// Chủ nhóm là một dòng ở đây với `role = 'owner'` — một nguồn duy nhất. CHECK viết tay:
/// group_members_moderator_unit_check (`moderator_unit_id` chỉ khi là điều hành viên),
/// group_members_role_since_check (có vai thì có lúc nhận vai).
model GroupMember {
  groupId         String        @map("group_id") @db.Uuid
  accountId       String        @map("account_id") @db.Uuid
  role            GroupRole     @default(member)
  /// Phạm vi của điều hành viên; null = cả nhóm.
  moderatorUnitId String?       @map("moderator_unit_id") @db.Uuid
  unitId          String?       @map("unit_id") @db.Uuid
  joinedVia       GroupJoinPath @map("joined_via")
  joinedAt        DateTime      @map("joined_at") @db.Timestamptz(3)
  /// Lúc nhận vai hiện tại — đề cử thiếu chủ xếp theo cột này.
  roleSince       DateTime?     @map("role_since") @db.Timestamptz(3)

  group         Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  account       Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  unit          GroupUnit? @relation("member_unit", fields: [groupId, unitId], references: [groupId, id], onDelete: Restrict)
  moderatorUnit GroupUnit? @relation("moderator_unit", fields: [groupId, moderatorUnitId], references: [groupId, id], onDelete: Restrict)

  @@id([groupId, accountId])
  @@unique([groupId], where: raw("role = 'owner'"), map: "group_members_one_owner_key")
  @@index([accountId])
  @@map("group_members")
}

model GroupBan {
  groupId   String   @map("group_id") @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  bannedBy  String   @map("banned_by") @db.Uuid
  bannedAt  DateTime @map("banned_at") @db.Timestamptz(3)

  group   Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([groupId, accountId])
  @@map("group_bans")
}

/// CHECK viết tay: group_join_requests_decided_check (đơn chờ chưa có lúc xử, đơn đã xử thì có).
model GroupJoinRequest {
  id        String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  groupId   String                 @map("group_id") @db.Uuid
  accountId String                 @map("account_id") @db.Uuid
  status    GroupJoinRequestStatus @default(pending)
  createdAt DateTime               @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime               @map("expires_at") @db.Timestamptz(3)
  decidedAt DateTime?              @map("decided_at") @db.Timestamptz(3)
  decidedBy String?                @map("decided_by") @db.Uuid

  group   Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([groupId, accountId], where: raw("status = 'pending'"), map: "group_join_requests_pending_key")
  @@index([accountId, status])
  @@index([groupId, status, createdAt])
  @@index([expiresAt], where: raw("status = 'pending'"), map: "group_join_requests_due_idx")
  @@map("group_join_requests")
}

/// `unit_id` không khoá ngoại: xoá đơn vị thì service gỡ đơn vị khỏi lời mời trong cùng transaction.
/// CHECK viết tay: group_invitations_decided_check.
/// Lời mời "mù" (change fix-audit-group): mời email nào cũng một dòng. `account_id` trống = không ai nhận được (email
/// chưa có tài khoản, đã là thành viên, là master, là chính người mời) — dòng vẫn hiện trong danh sách y như dòng thật,
/// để danh sách không lộ email nào đã có tài khoản (TK 10). `email_hash` cùng khoá với `accounts.email_hash`;
/// `email_hint` là email đã che (`a***@mien.vn`) cho danh sách của người quản lý.
model GroupInvitation {
  id        String                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  groupId   String                @map("group_id") @db.Uuid
  accountId String?               @map("account_id") @db.Uuid
  emailHash String                @map("email_hash")
  emailHint String                @map("email_hint")
  unitId    String?               @map("unit_id") @db.Uuid
  invitedBy String                @map("invited_by") @db.Uuid
  status    GroupInvitationStatus @default(pending)
  createdAt DateTime              @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime              @map("expires_at") @db.Timestamptz(3)
  decidedAt DateTime?             @map("decided_at") @db.Timestamptz(3)

  group   Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  account Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([groupId, emailHash], where: raw("status = 'pending'"), map: "group_invitations_pending_key")
  @@index([accountId, status])
  @@index([expiresAt], where: raw("status = 'pending'"), map: "group_invitations_due_idx")
  @@map("group_invitations")
}

/// Danh sách lớp: chỉ dấu băm HMAC của email đã chuẩn hoá — cùng khoá với `accounts.email_hash`, nên khớp
/// người mà không giữ email thô (TK 10).
model GroupRosterEntry {
  groupId   String   @map("group_id") @db.Uuid
  emailHash String   @map("email_hash")
  unitId    String?  @map("unit_id") @db.Uuid
  addedBy   String   @map("added_by") @db.Uuid
  addedAt   DateTime @map("added_at") @db.Timestamptz(3)

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([groupId, emailHash])
  @@index([emailHash])
  @@map("group_roster_entries")
}

/// Ba đường giao chủ chung một bảng: master giao (lần đầu, nhóm thiếu chủ, giao đè) và chủ chuyển nhượng.
/// CHECK viết tay: group_owner_offers_decided_check.
model GroupOwnerOffer {
  id            String                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  groupId       String                @map("group_id") @db.Uuid
  kind          GroupOwnerOfferKind
  fromAccountId String?               @map("from_account_id") @db.Uuid
  toAccountId   String                @map("to_account_id") @db.Uuid
  status        GroupOwnerOfferStatus @default(pending)
  createdAt     DateTime              @map("created_at") @db.Timestamptz(3)
  expiresAt     DateTime              @map("expires_at") @db.Timestamptz(3)
  decidedAt     DateTime?             @map("decided_at") @db.Timestamptz(3)

  group     Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  toAccount Account @relation(fields: [toAccountId], references: [id], onDelete: Cascade)

  @@unique([groupId], where: raw("status = 'pending'"), map: "group_owner_offers_pending_key")
  @@index([toAccountId, status])
  @@index([expiresAt], where: raw("status = 'pending'"), map: "group_owner_offers_due_idx")
  @@map("group_owner_offers")
}

/// `unit_id` = phạm vi (null = cả nhóm), không khoá ngoại vì cùng lý do với lời mời.
model GroupAnnouncement {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  groupId   String   @map("group_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  unitId    String?  @map("unit_id") @db.Uuid
  body      String
  createdAt DateTime @map("created_at") @db.Timestamptz(3)

  group Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  /// Xoá đơn vị thì xoá thông báo gửi riêng cho nó: không ai còn thuộc đơn vị đó, và để trống `unit_id` thì thông báo
  /// thành gửi cả nhóm (rà soát L6, change fix-audit-group-low).
  unit  GroupUnit? @relation(fields: [groupId, unitId], references: [groupId, id], onDelete: Cascade)

  @@index([groupId, createdAt])
  @@map("group_announcements")
}

// ── NOTIFICATION ─────────────────────────────────────────────────────────────────────────────────

/// Chín nhóm thông báo của TK 24, bật tắt được từng nhóm (trừ `account`).
enum NotificationCategory {
  messages
  your_listings
  your_groups
  your_reports
  account
  trust_strikes
  group_announcements
  group_new_listings
  support
  saved_searches

  @@map("notification_category")
}

/// Một dòng hộp thư. Văn bản sinh lúc ghi từ mẫu trong code; `detail` chỉ người được xem mới có (vd lý do khoá nhóm
/// cho chủ nhóm) và không bao giờ nằm trong câu nhắc. Dòng gộp (`collapse_key`) được cập nhật thay vì thêm mới khi
/// người nhận chưa đọc; `source_event_id` là sự kiện outbox gần nhất đã áp vào dòng — giao trùng không ghi hai lần.
/// CHECK viết tay: notifications_count_check (`count` >= 1).
model Notification {
  id            String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  recipientId   String               @map("recipient_id") @db.Uuid
  category      NotificationCategory
  type          String
  title         String
  body          String
  detail        String?
  data          Json                 @db.JsonB
  groupId       String?              @map("group_id") @db.Uuid
  collapseKey   String?              @map("collapse_key")
  count         Int                  @default(1)
  alert         Boolean
  alertedAt     DateTime?            @map("alerted_at") @db.Timestamptz(3)
  readAt        DateTime?            @map("read_at") @db.Timestamptz(3)
  sourceEventId String               @map("source_event_id") @db.Uuid
  createdAt     DateTime             @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime             @map("updated_at") @db.Timestamptz(3)

  recipient Account @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([sourceEventId, recipientId])
  @@index([recipientId, updatedAt])
  @@index([recipientId], where: raw("read_at IS NULL"), map: "notifications_unread_idx")
  @@index([recipientId, collapseKey], where: raw("read_at IS NULL AND collapse_key IS NOT NULL"), map: "notifications_collapse_idx")
  @@index([updatedAt], map: "notifications_retention_idx")
  @@map("notifications")
}

/// Chỉ lưu nhóm người dùng đã đổi khỏi mặc định (bật); không có dòng = đang bật.
model NotificationPreference {
  accountId String               @map("account_id") @db.Uuid
  category  NotificationCategory
  enabled   Boolean

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([accountId, category])
  @@map("notification_preferences")
}

/// Tắt tiếng một nhóm: thông báo của nhóm vẫn vào hộp thư nhưng không nhắc, trừ chuyện về chính tư cách người đó.
model GroupNotificationMute {
  accountId String   @map("account_id") @db.Uuid
  groupId   String   @map("group_id") @db.Uuid
  createdAt DateTime @map("created_at") @db.Timestamptz(3)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  group   Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([accountId, groupId])
  @@map("group_notification_mutes")
}

// ── MEDIA ────────────────────────────────────────────────────────────────────────────────────────

/// Loại chủ của một ảnh: ảnh đại diện của tài khoản (`profile`) hay ảnh của tin (`listing`).
enum ImageOwnerKind {
  profile
  listing

  @@map("image_owner_kind")
}

/// Một ảnh trong kho (TK 25). Mã ảnh cũng là khoá trong kho (`img/<id>`), nên ai có mã là ký được đường xem.
/// Dòng có trước tệp: ghi lúc cấp quyền tải, `uploaded_at` ghi khi lần đầu thấy tệp trong kho.
/// CHECK tay (migration init_media):
///   images_uploaded_check:  confirmed_at IS NULL OR uploaded_at IS NOT NULL
///   images_released_check:  released_at IS NULL OR confirmed_at IS NOT NULL
///   images_byte_size_check: byte_size > 0
model Image {
  id          String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  ownerKind   ImageOwnerKind @map("owner_kind")
  ownerId     String         @map("owner_id") @db.Uuid
  uploaderId  String         @map("uploader_id") @db.Uuid
  contentType String         @map("content_type")
  byteSize    Int            @map("byte_size")
  uploadedAt  DateTime?      @map("uploaded_at") @db.Timestamptz(3)
  /// `null` = nhãn "chưa xác nhận".
  confirmedAt DateTime?      @map("confirmed_at") @db.Timestamptz(3)
  /// Chủ đã lưu lại mà không còn ảnh này — lượt đối chiếu hằng tháng dọn.
  releasedAt  DateTime?      @map("released_at") @db.Timestamptz(3)
  /// Lúc cấp quyền tải — mốc 48 giờ của lượt dọn.
  createdAt   DateTime       @map("created_at") @db.Timestamptz(3)

  /// Xoá hẳn tài khoản thì dòng đi theo; tệp thành mồ côi và lượt đối chiếu vét.
  uploader Account @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([ownerKind, ownerId])
  @@index([uploaderId, createdAt])
  @@index([createdAt], where: raw("confirmed_at IS NULL"), map: "images_unconfirmed_idx")
  @@index([releasedAt], where: raw("released_at IS NOT NULL"), map: "images_released_idx")
  @@map("images")
}

// ── LISTING: ENUM ────────────────────────────────────────────────────────────────────────────────

/// Tám trạng thái của TK 18. Đổi trạng thái chỉ qua bảng mũi tên `listing.calc.ts` (CLAUDE.md luật 13).
enum ListingState {
  draft
  checking
  pending
  live
  rejected
  sold
  expired
  removed

  @@map("listing_state")
}

enum ListingPlacement {
  marketplace
  group_public
  members_only

  @@map("listing_placement")
}

/// Lý do tạm ẩn — tách khỏi trạng thái (TK 19). Ba lý do cuối là "rời nhóm hẳn": không gỡ, chỉ chuyển lên sàn chung.
enum ListingHideReason {
  account_locked
  account_deleted
  left_group
  removed_from_group
  group_banned
  group_locked
  category_disabled
  group_closed
  group_privatized
  detached_by_group
  /// Nhiều người đáng tin cùng báo (add-reports): chỉ quyết định của người xử gỡ được.
  reported

  @@map("listing_hide_reason")
}

/// Lý do hiển thị hạn chế (TK 15): mỗi lý do đặt và gỡ độc lập; mảng rỗng = đầy đủ.
enum ListingRestriction {
  machine
  new_account
  /// Lên bảng khi người bán đang có gậy — gỡ khi điểm gậy về 0 (add-strikes).
  strike
  /// Điểm gậy chạm 2: mọi tin đang hiện bị hạn chế — gỡ khi điểm về dưới 2 (add-strikes).
  strike_wave

  @@map("listing_restriction")
}

enum ListingRenewal {
  early
  expired

  @@map("listing_renewal")
}

/// Người duyệt từ chối / gỡ vì sai sót (sửa được) hay vi phạm (TK 17).
enum ListingFault {
  mistake
  violation

  @@map("listing_fault")
}

enum ListingSubmissionKind {
  submit
  resubmit
  renew_early
  renew_expired
  move

  @@map("listing_submission_kind")
}

// ── LISTING: BẢNG ────────────────────────────────────────────────────────────────────────────────

/// Một tin, từ nháp tới hết đời (design add-listings mục 1). CHECK tay (migration init_listing):
///   listings_arrays_check:           image_ids, hide_reasons, restrictions NOT NULL (Prisma tạo cột mảng cho phép null;
///                                    null thì cardinality() ra null và tin lọt khỏi mọi partial index)
///   listings_version_check:          version >= 1
///   listings_price_check:            price IS NULL OR price >= 0
///   listings_placement_group_check:  placement IS NULL OR (placement = 'marketplace') = (group_id IS NULL)
///   listings_submitted_check:        state = 'draft' OR đủ nơi đăng, tiêu đề, giá, danh mục, ≥ 1 ảnh (danh mục chưa
///                                    phát hành mẫu thì không có phiên bản để ghim)
///   listings_badge_check:            badge_group_id IS NULL OR placement = 'marketplace'
///   listings_ward_check:             ward_code IS NULL OR province_code IS NOT NULL
///   listings_clock_check:            không cùng lúc expires_at và clock_remaining_ms
///   listings_clock_started_check:    chưa lên bảng (first_live_at IS NULL) thì không có đồng hồ, không có shown_since
///   listings_shown_check:            shown_ms >= 0
///   listings_renewal_check:          renewal IS NULL OR state IN ('draft', 'checking', 'pending')
///   listings_fault_check:            fault IS NULL OR state IN ('rejected', 'removed')
/// CHECK tay (migration prepare_promotions):
///   listings_rank_check:             (rank_at IS NULL) = (first_live_at IS NULL) — vị trí đi cùng mốc lên bảng tới khi có gói đẩy tin
model Listing {
  id                 String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  ownerId            String               @map("owner_id") @db.Uuid
  state              ListingState         @default(draft)
  /// Tăng khi nội dung, nơi đăng hay trạng thái đổi — không tăng khi đặt / gỡ lý do tạm ẩn hay hạn chế, để việc
  /// đang mở của người duyệt (ghi có điều kiện theo phiên bản) không hỏng vì nhóm bị khoá giữa chừng.
  version            Int                  @default(1)
  placement          ListingPlacement?
  groupId            String?              @map("group_id") @db.Uuid
  /// Không khoá ngoại: tin theo đơn vị hiện tại của người đăng (bên nghe đổi), và xoá đơn vị trống không được vướng
  /// tin cũ; khoá ngoại ghép (group_id, unit_id) mà SET NULL thì xoá luôn cả group_id.
  unitId             String?              @map("unit_id") @db.Uuid
  categoryId         String?              @map("category_id") @db.Uuid
  /// Ghim ở lần gửi đầu; sửa về sau kiểm theo đúng phiên bản này (TK 11).
  templateVersion    Int?                 @map("template_version")
  attributes         Json                 @default("{}") @db.JsonB
  title              String?
  description        String?
  /// Đồng, BigInt, 0 = cho tặng.
  price              BigInt?
  negotiable         Boolean              @default(false)
  delivery           Boolean              @default(false)
  showPhone          Boolean              @default(false) @map("show_phone")
  provinceCode       Int?                 @map("province_code")
  wardCode           Int?                 @map("ward_code")
  /// Thứ tự là dữ liệu: phần tử đầu là ảnh bìa. Quyền với ảnh nằm ở `images` (chủ = tin này).
  imageIds           String[]             @default([]) @map("image_ids") @db.Uuid
  badgeGroupId       String?              @map("badge_group_id") @db.Uuid
  hideReasons        ListingHideReason[]  @default([]) @map("hide_reasons")
  restrictions       ListingRestriction[] @default([])
  /// Vị trí trên bảng tin: không đổi khi sửa hay gia hạn.
  firstLiveAt        DateTime?            @map("first_live_at") @db.Timestamptz(3)
  /// Vị trí xếp hạng trên bảng tin (TK 30 `rankAt`, change prepare-promotions): = `first_live_at` lúc lên bảng lần đầu, tin
  /// trùng của chính mình kế thừa tin cũ; chỉ gói đẩy tin (TK 29, hoãn) mới đổi. Bốn index bảng tin xếp theo cột này.
  rankAt             DateTime?            @map("rank_at") @db.Timestamptz(3)
  /// Hạn tin nổi bật (TK 30 `featuredUntil`) — giữ chỗ, luôn null tới khi có gói đẩy tin.
  featuredUntil      DateTime?            @map("featured_until") @db.Timestamptz(3)
  /// Đồng hồ ngày hiển thị: `expires_at` khi đang chạy, `clock_remaining_ms` khi đang dừng.
  expiresAt          DateTime?            @map("expires_at") @db.Timestamptz(3)
  clockRemainingMs   BigInt?              @map("clock_remaining_ms")
  /// Thời gian tin thật sự được thấy (đang hiển thị, không tạm ẩn) — dữ kiện tin sạch của `trust`.
  shownMs            BigInt               @default(0) @map("shown_ms")
  shownSince         DateTime?            @map("shown_since") @db.Timestamptz(3)
  renewal            ListingRenewal?
  fault              ListingFault?
  /// Lý do mẫu người duyệt chọn khi từ chối / gỡ — người đăng thấy (add-review-queues). CHECK tay (migration
  /// init_review): listings_fault_reason_check: fault_reason IS NULL OR fault IS NOT NULL
  faultReason        String?              @map("fault_reason")
  /// Lúc rời nhóm hẳn — mốc của hạn chuyển lên sàn chung.
  leftGroupAt        DateTime?            @map("left_group_at") @db.Timestamptz(3)
  movedFromListingId String?              @map("moved_from_listing_id") @db.Uuid
  /// `expires_at` đã được nhắc: nhắc một lần cho mỗi hạn, gia hạn đổi hạn thì được nhắc lại.
  remindedFor        DateTime?            @map("reminded_for") @db.Timestamptz(3)
  /// `expires_at` đã được nhắc "sắp bị xoá hẳn" (add-data-retention): một lần mỗi hạn, như `reminded_for`.
  purgeRemindedFor   DateTime?            @map("purge_reminded_for") @db.Timestamptz(3)
  /// `fold(title + ' ' + description)` — tìm có dấu / không dấu bằng LIKE.
  searchFolded       String               @default("") @map("search_folded")
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt          DateTime?            @map("deleted_at") @db.Timestamptz(3)

  owner            Account                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  group            Group?                  @relation("listing_group", fields: [groupId], references: [id], onDelete: Restrict)
  category         Category?               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  province         Province?               @relation(fields: [provinceCode], references: [code], onDelete: Restrict)
  ward             Ward?                   @relation(fields: [wardCode], references: [code], onDelete: Restrict)
  badgeGroup       Group?                  @relation("listing_badge", fields: [badgeGroupId], references: [id], onDelete: Restrict)
  /// Tin cũ bị xoá hẳn thì tin mới vẫn sống; chỉ mất dấu "đã chuyển từ đâu".
  movedFrom        Listing?                @relation("listing_move", fields: [movedFromListingId], references: [id], onDelete: SetNull)
  movedTo          Listing[]               @relation("listing_move")
  submissions      ListingSubmission[]
  badgeBlocks      ListingBadgeBlock[]
  reviewTasks      ReviewTask[]
  sampleCandidates ReviewSampleCandidate[]
  savedBy          SavedListing[]

  /// Mỗi tin chuyển lên sàn chung một lần (ALREADY_MOVED) — kể cả hai lượt song song.
  @@unique([movedFromListingId], where: raw("moved_from_listing_id IS NOT NULL"), map: "listings_moved_from_key")
  @@index([rankAt(sort: Desc), id(sort: Desc)], where: raw("state = 'live' AND placement = 'marketplace' AND cardinality(hide_reasons) = 0 AND cardinality(restrictions) = 0 AND deleted_at IS NULL"), map: "listings_feed_idx")
  @@index([categoryId, rankAt(sort: Desc), id(sort: Desc)], where: raw("state = 'live' AND placement = 'marketplace' AND cardinality(hide_reasons) = 0 AND cardinality(restrictions) = 0 AND deleted_at IS NULL"), map: "listings_feed_category_idx")
  @@index([rankAt(sort: Desc), id(sort: Desc)], where: raw("state = 'live' AND placement = 'marketplace' AND cardinality(hide_reasons) = 0 AND deleted_at IS NULL"), map: "listings_search_idx")
  @@index([groupId, rankAt(sort: Desc), id(sort: Desc)], where: raw("state = 'live' AND cardinality(hide_reasons) = 0 AND deleted_at IS NULL"), map: "listings_group_feed_idx")
  @@index([featuredUntil], where: raw("featured_until IS NOT NULL"), map: "listings_featured_idx")
  @@index([expiresAt], where: raw("state = 'live' AND expires_at IS NOT NULL"), map: "listings_expiry_idx")
  @@index([groupId], where: raw("deleted_at IS NULL"), map: "listings_group_idx")
  @@index([categoryId], where: raw("deleted_at IS NULL"), map: "listings_category_idx")
  @@index([badgeGroupId], where: raw("badge_group_id IS NOT NULL"), map: "listings_badge_idx")
  @@index([ownerId, updatedAt(sort: Desc)], where: raw("deleted_at IS NULL"), map: "listings_owner_idx")
  /// Ba index cho lượt dọn theo hạn lưu (add-data-retention): theo trạng thái + lần sửa cuối, tin đã xoá mềm, tin hết hạn.
  @@index([state, updatedAt], where: raw("deleted_at IS NULL"), map: "listings_retention_idx")
  @@index([deletedAt], where: raw("deleted_at IS NOT NULL"), map: "listings_deleted_idx")
  @@index([expiresAt], where: raw("state = 'expired'"), map: "listings_expired_idx")
  @@map("listings")
}

/// Mỗi lượt gửi một dòng: chặn bấm Đăng hai lần, và là dữ kiện nhịp gửi của `trust`, lượt gửi dồn của `screening`.
model ListingSubmission {
  id          String                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  listingId   String                @map("listing_id") @db.Uuid
  accountId   String                @map("account_id") @db.Uuid
  kind        ListingSubmissionKind
  /// Phiên bản của tin lúc gửi — một phiên bản chỉ gửi được một lần.
  fromVersion Int                   @map("from_version")
  at          DateTime              @db.Timestamptz(3)

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([listingId, fromVersion])
  @@index([accountId, at])
  @@map("listing_submissions")
}

/// Tin người dùng lưu để xem lại (add-saved-listings, TK 15 "Tin đã lưu"). Lần lưu giữ khi tin thôi hiện — danh sách lọc
/// lúc đọc, tin hiện lại thì có lại. Xoá tài khoản thì `listing` xoá qua sự kiện (tài khoản chỉ ẩn danh, không xoá dòng).
model SavedListing {
  accountId String   @map("account_id") @db.Uuid
  listingId String   @map("listing_id") @db.Uuid
  savedAt   DateTime @map("saved_at") @db.Timestamptz(3)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([accountId, listingId])
  @@index([accountId, savedAt(sort: Desc), listingId(sort: Desc)])
  @@index([listingId])
  @@map("saved_listings")
}

/// Lượt tìm trên sàn chung người dùng lưu để được báo tin mới khớp (add-saved-searches, TK 24). `key` = từ khoá đã bỏ
/// dấu cùng bộ lọc, viết thành một chuỗi: lưu lại đúng lượt tìm không thêm dòng, và cột nullable không cần NULLS NOT
/// DISTINCT. Xoá tài khoản thì `listing` xoá qua sự kiện (tài khoản chỉ ẩn danh, không xoá dòng).
/// CHECK viết tay (migration add_saved_searches): `saved_searches_q_folded_check` — từ khoá đã bỏ dấu không rỗng;
/// `saved_searches_price_range_check` — giá từ không lớn hơn giá đến khi có cả hai.
model SavedSearch {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  accountId    String   @map("account_id") @db.Uuid
  key          String
  q            String
  qFolded      String   @map("q_folded")
  categoryId   String?  @map("category_id") @db.Uuid
  provinceCode Int?     @map("province_code")
  wardCode     Int?     @map("ward_code")
  priceMin     BigInt?  @map("price_min")
  priceMax     BigInt?  @map("price_max")
  createdAt    DateTime @map("created_at") @db.Timestamptz(3)

  account  Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([accountId, key])
  @@index([accountId, createdAt(sort: Desc)])
  @@map("saved_searches")
}

/// Huy hiệu nhóm đã gỡ khỏi tin này thì người đăng không gắn lại (TK 10, chốt 12/10/2026).
model ListingBadgeBlock {
  listingId String   @map("listing_id") @db.Uuid
  groupId   String   @map("group_id") @db.Uuid
  removedBy String   @map("removed_by") @db.Uuid
  removedAt DateTime @map("removed_at") @db.Timestamptz(3)

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  group   Group   @relation(fields: [groupId], references: [id])

  @@id([listingId, groupId])
  @@map("listing_badge_blocks")
}

// ── TRUST: ENUM ──────────────────────────────────────────────────────────────────────────────────

/// Mức tin cậy (TK 20). Tài khoản chưa có dòng `trust_tiers` là T0.
enum TrustTier {
  T0
  T1
  T2
  T3

  @@map("trust_tier")
}

/// Lối thành tin sạch (TK 20): hiện đủ ngày, hay đã bán có người hỏi mua.
enum TrustCleanVia {
  shown
  sold

  @@map("trust_clean_via")
}

/// Vì sao tin thôi được tính là sạch: gỡ / từ chối vì vi phạm, hay báo cáo được xác nhận đúng (`add-reports`).
enum TrustVoidCause {
  violation
  report

  @@map("trust_void_cause")
}

// ── TRUST: BẢNG ──────────────────────────────────────────────────────────────────────────────────

/// Dữ kiện "tin X thành sạch lúc D", không phải điểm (design add-trust-tiers mục 3). Không FK sang `listings`: dữ kiện
/// sống lâu hơn tin, mức người bán lâu năm không tụt khi tin cũ bị dọn (câu 4). CHECK tay (migration init_trust):
///   trust_clean_listings_clean_check: (clean_at IS NULL) = (via IS NULL)
///   trust_clean_listings_void_check:  (voided_at IS NULL) = (void_cause IS NULL)
///   trust_clean_listings_fact_check:  clean_at IS NOT NULL OR voided_at IS NOT NULL — dòng chỉ mang dấu void có khi tin bị
///                                     gỡ trước lúc lượt phát hiện sạch ghi mốc (mục 13)
model TrustCleanListing {
  listingId String          @id @map("listing_id") @db.Uuid
  accountId String          @map("account_id") @db.Uuid
  via       TrustCleanVia?
  cleanAt   DateTime?       @map("clean_at") @db.Timestamptz(3)
  voidedAt  DateTime?       @map("voided_at") @db.Timestamptz(3)
  voidCause TrustVoidCause? @map("void_cause")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("trust_clean_listings")
}

/// Kết quả lần tính gần nhất — để trả nhanh `tierOf`, biết lúc mức đổi, và biết tài khoản nào còn mang phiên bản bảng
/// con số cũ (design mục 3, câu 9). Chưa có dòng = T0. CHECK tay (migration init_trust):
///   trust_tiers_counted_check: counted_clean >= 0
model TrustTierResult {
  accountId     String    @id @map("account_id") @db.Uuid
  tier          TrustTier
  countedClean  Int       @map("counted_clean")
  /// SHA-256 của dữ kiện đã chuẩn hoá + phiên bản bảng con số: tính lại ra cùng dấu thì không ghi gì.
  factsHash     String    @map("facts_hash")
  configVersion Int       @map("config_version")
  computedAt    DateTime  @map("computed_at") @db.Timestamptz(3)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([configVersion])
  @@map("trust_tiers")
}

/// Mỗi lần mức đổi một dòng, ghi kèm dấu dữ kiện và phiên bản bảng con số đã dùng (TK 27 cam kết 11, 33).
/// CHECK tay (migration init_trust):
///   trust_tier_changes_change_check: from_tier <> to_tier
model TrustTierChange {
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  accountId     String    @map("account_id") @db.Uuid
  fromTier      TrustTier @map("from_tier")
  toTier        TrustTier @map("to_tier")
  factsHash     String    @map("facts_hash")
  configVersion Int       @map("config_version")
  at            DateTime  @db.Timestamptz(3)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, at])
  @@map("trust_tier_changes")
}

// ── SCREENING: ENUM ──────────────────────────────────────────────────────────────────────────────

/// Lượt qua máy mở vì gửi tin, hay vì bật thật một cụm từ cấm mà tin đang hiện chứa nó (design add-screening mục 7).
enum ScreeningTrigger {
  submission
  recall

  @@map("screening_trigger")
}

/// Ba kết quả của máy — không có "từ chối" (TK 13, CLAUDE.md luật 14).
enum ScreeningOutcome {
  pass_full
  pass_limited
  hold

  @@map("screening_outcome")
}

/// Vì sao lượt ra kết quả đó — "bị giữ nhiều" chỉ đếm `score` và `gate` (câu 15).
enum ScreeningCause {
  score
  gate
  always_manual
  device
  error
  timeout
  /// Ảnh hỏng hay luật chất lượng ảnh đang bật trúng (add-image-quality-checks): lỗi tự sửa được, không tính dò.
  image_quality

  @@map("screening_cause")
}

enum ScreeningBand {
  low
  medium
  high

  @@map("screening_band")
}

enum ImageCheckStatus {
  pending
  done
  error

  @@map("image_check_status")
}

/// Loại lỗi của việc kiểm ảnh: `transient` = kho không trả lời sau mọi lượt thử — lượt gửi sau kiểm lại; `permanent` =
/// tệp mất hay không giải mã được (fix-audit-screening-trust, T21).
enum ImageCheckErrorKind {
  transient
  permanent

  @@map("image_check_error_kind")
}

/// Dấu hiệu cộng điểm, hay cổng cứng giữ tin (TK 13, 14).
enum ScreeningRuleKind {
  signal
  gate
  /// Luật chất lượng ảnh: trúng thì giữ cho người như cổng cứng, nhưng tắt được và không tính dò (add-image-quality-checks).
  quality

  @@map("screening_rule_kind")
}

/// Bật · chạy thử (chấm, ghi, không đổi kết quả) · tắt (không chấm) — luật và cụm từ cấm dùng chung.
enum ScreeningRuleMode {
  on
  trial
  off

  @@map("screening_rule_mode")
}

/// Cụm mức chắc là cổng cứng; mức mơ hồ chỉ cộng điểm (TK 13).
enum BannedPhraseLevel {
  certain
  ambiguous

  @@map("banned_phrase_level")
}

// ── SCREENING: BẢNG ──────────────────────────────────────────────────────────────────────────────

/// Một lượt qua máy của một phiên bản tin (design add-screening mục 4, 5). Không FK sang `listings`: kết quả giữ theo hạn
/// lưu của `screening` (`add-data-retention`), không theo tin. CHECK tay (migration init_screening):
///   screening_runs_decided_check: (decided_at IS NULL) = (outcome IS NULL) AND (outcome IS NULL) = (cause IS NULL)
///   screening_runs_score_check:   score IS NULL OR score >= 0
model ScreeningRun {
  id              String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  listingId       String            @map("listing_id") @db.Uuid
  listingVersion  Int               @map("listing_version")
  accountId       String            @map("account_id") @db.Uuid
  trigger         ScreeningTrigger
  startedAt       DateTime          @map("started_at") @db.Timestamptz(3)
  /// Kết quả chấm chữ lúc gửi (dấu hiệu chữ, cổng chữ, chỗ trúng) — `{ "error": … }` khi chấm lỗi hay quá trần.
  textResult      Json              @map("text_result")
  imageIds        String[]          @map("image_ids") @db.Uuid
  decidedAt       DateTime?         @map("decided_at") @db.Timestamptz(3)
  outcome         ScreeningOutcome?
  cause           ScreeningCause?
  score           Int?
  band            ScreeningBand?
  tier            TrustTier?
  /// Mọi luật đã trúng (kể cả chạy thử), cụm, ảnh trùng — người duyệt và hỗ trợ đọc; người đăng không bao giờ thấy.
  hits            Json              @default("[]")
  /// Câu cho người đăng: `plain` / `fraud` kèm mã tra cứu, và các lỗi tự sửa được (mục 8).
  explanation     Json?
  /// Mỗi lần giữ có dấu hiệu gian lận một mã (câu 11); cùng bộ chữ Crockford với mã của `identity`, khác tiền tố.
  lookupCode      String?           @unique @map("lookup_code")
  rankAsListingId String?           @map("rank_as_listing_id") @db.Uuid
  configVersion   Int               @map("config_version")
  ruleVersion     Int               @map("rule_version")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([listingId, listingVersion, trigger])
  @@index([accountId, decidedAt])
  @@index([startedAt], where: raw("decided_at IS NULL"), map: "screening_runs_open_idx")
  @@index([imageIds], type: Gin, where: raw("decided_at IS NULL"), map: "screening_runs_open_images_idx")
  @@index([startedAt], map: "screening_runs_retention_idx")
  @@map("screening_runs")
}

/// Kết quả kiểm của một ảnh — ảnh bất biến nên dùng lại khi tin sửa mà giữ ảnh (mục 4). dHash 64 bit chia 5 dải để tìm
/// ứng viên: hai ảnh lệch ≤ 4 bit chắc chắn trùng nguyên ít nhất một dải (design mục 3). CHECK tay (migration
/// init_screening):
///   image_checks_done_check: (status = 'done') = (dhash IS NOT NULL)
/// CHECK tay (migration fix_audit_image_retry):
///   image_checks_error_kind_check: (status = 'error') = (error_kind IS NOT NULL)
model ImageCheck {
  imageId        String               @id @map("image_id") @db.Uuid
  ownerAccountId String               @map("owner_account_id") @db.Uuid
  status         ImageCheckStatus
  dhash          BigInt?
  band0          Int?
  band1          Int?
  band2          Int?
  band3          Int?
  band4          Int?
  attempts       Int                  @default(0)
  checkedAt      DateTime?            @map("checked_at") @db.Timestamptz(3)
  /// Lần xếp việc kiểm gần nhất; trống = chưa xếp được (gửi việc hỏng). Ảnh `pending` trống hay xếp quá thời gian chờ
  /// ảnh thì được xếp lại — mỗi ảnh một lần mỗi khoảng, không dồn việc trùng (fix-audit-image-checks).
  queuedAt       DateTime?            @map("queued_at") @db.Timestamptz(3)
  errorKind      ImageCheckErrorKind? @map("error_kind")
  /// Số đo chất lượng (add-image-quality-checks), trống với ảnh kiểm trước change đó. Rộng, cao sau khi xoay theo EXIF.
  width          Int?
  height         Int?
  /// Phương sai sau toán tử Laplace trên ảnh xám thu về cạnh dài 512 px.
  sharpness      Float?
  /// Trung bình kênh xám, 0–255.
  brightness     Float?

  @@index([queuedAt], where: raw("status = 'pending'"), map: "image_checks_pending_queued_idx")
  @@index([band0], where: raw("status = 'done'"), map: "image_checks_band0_idx")
  @@index([band1], where: raw("status = 'done'"), map: "image_checks_band1_idx")
  @@index([band2], where: raw("status = 'done'"), map: "image_checks_band2_idx")
  @@index([band3], where: raw("status = 'done'"), map: "image_checks_band3_idx")
  @@index([band4], where: raw("status = 'done'"), map: "image_checks_band4_idx")
  @@map("image_checks")
}

/// Lưới an toàn đã hạn chế "máy" tin này ở phiên bản này vì thiếu kết quả ảnh — mỗi phiên bản một lần, để lượt cho đạt
/// của người duyệt là cuối cùng (fix-audit-image-checks, C2). Không khoá ngoại sang `listings`: bảng của module khác.
model ScreeningUncheckedMark {
  listingId      String   @map("listing_id") @db.Uuid
  listingVersion Int      @map("listing_version")
  markedAt       DateTime @map("marked_at") @db.Timestamptz(3)

  @@id([listingId, listingVersion])
  @@map("screening_unchecked_marks")
}

/// Kết quả máy quá hạn lưu gộp lại (TK 25, add-data-retention): theo tháng × phiên bản luật × phiên bản bảng con số ×
/// kết quả × nguyên nhân × dải × mã luật đã trúng (`'*'` = dòng tổng của lượt). `cause`, `band` rỗng khi lượt không có —
/// cột khoá chính không nhận null. Tỉ lệ "máy giữ mà người cho qua" tính từ `review_decisions` (giữ mãi), không từ đây.
model ScreeningRunStat {
  month         DateTime @db.Date
  ruleVersion   Int      @map("rule_version")
  configVersion Int      @map("config_version")
  outcome       String
  cause         String
  band          String
  ruleCode      String   @map("rule_code")
  runs          Int

  @@id([month, ruleVersion, configVersion, outcome, cause, band, ruleCode])
  @@map("screening_run_stats")
}

/// Ảnh mẫu của hãng nhiều người cùng dùng — trùng với ảnh ở đây thì không tính là ảnh trùng (spec image-checks).
model ImageWhitelistEntry {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  dhash         BigInt
  band0         Int
  band1         Int
  band2         Int
  band3         Int
  band4         Int
  sourceImageId String   @map("source_image_id") @db.Uuid
  addedBy       String   @map("added_by") @db.Uuid
  addedAt       DateTime @map("added_at") @db.Timestamptz(3)

  @@index([band0])
  @@index([band1])
  @@index([band2])
  @@index([band3])
  @@index([band4])
  @@map("image_whitelist")
}

/// Luật của máy: mã ổn định, trọng số, chế độ (spec rule-management). CHECK tay (migration init_screening):
///   screening_rules_gate_check:   kind <> 'gate' OR mode <> 'off' — cổng cứng chạy thử được, không tắt được (câu 19)
///   screening_rules_weight_check: weight >= 0
model ScreeningRule {
  code   String            @id
  kind   ScreeningRuleKind
  weight Int
  mode   ScreeningRuleMode

  overrides ScreeningRuleOverride[]

  @@map("screening_rules")
}

/// Trọng số / chế độ riêng của một luật cho một danh mục — tin danh mục đó dùng giá trị riêng. CHECK tay (migration
/// init_screening):
///   screening_rule_overrides_value_check: weight IS NOT NULL OR mode IS NOT NULL
///   screening_rule_overrides_weight_check: weight IS NULL OR weight >= 0
model ScreeningRuleOverride {
  code       String             @db.Text
  categoryId String             @map("category_id") @db.Uuid
  weight     Int?
  mode       ScreeningRuleMode?

  rule     ScreeningRule @relation(fields: [code], references: [code], onDelete: Cascade)
  category Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([code, categoryId])
  @@map("screening_rule_overrides")
}

/// Ngưỡng dải riêng của một danh mục; không có dòng thì dùng ngưỡng chung của bảng con số. CHECK tay (migration
/// init_screening):
///   screening_category_bands_order_check: 0 < medium_from AND medium_from < high_from
model ScreeningCategoryBand {
  categoryId String @id @map("category_id") @db.Uuid
  mediumFrom Int    @map("medium_from")
  highFrom   Int    @map("high_from")

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@map("screening_category_bands")
}

/// Mỗi lần đổi luật, ghi đè, dải hay cụm từ một dòng — một kết quả chỉ cần `config_version` và `rule_version` để biết
/// đã chấm theo gì (cam kết 33, D6).
model ScreeningRuleVersion {
  version   Int      @id
  snapshot  Json
  /// Trống ở phiên bản 1 do hệ thống khởi tạo.
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @map("created_at") @db.Timestamptz(3)

  @@map("screening_rule_versions")
}

/// Cụm từ cấm (spec banned-phrases). CHECK tay (migration init_screening):
///   banned_phrases_words_check: folded ~ '\S\s+\S' — từ hai chữ trở lên (service trả 400 trước)
///   banned_phrases_trial_check: mode <> 'trial' OR trial_ends_at IS NOT NULL
model BannedPhrase {
  id               String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  text             String
  /// Chữ đã `fold` — so khớp và chặn trùng trên cột này.
  folded           String            @unique
  level            BannedPhraseLevel
  mode             ScreeningRuleMode
  trialEndsAt      DateTime?         @map("trial_ends_at") @db.Timestamptz(3)
  activatedAt      DateTime?         @map("activated_at") @db.Timestamptz(3)
  activatedBy      String?           @map("activated_by") @db.Uuid
  activationReason String?           @map("activation_reason")
  /// Ngoại lệ đã `fold`: chỗ trúng nằm trọn trong một chỗ trúng của ngoại lệ thì bỏ (mục 7).
  exceptions       String[]
  createdBy        String            @map("created_by") @db.Uuid
  createdAt        DateTime          @map("created_at") @db.Timestamptz(3)

  @@map("banned_phrases")
}

/// Thời gian chờ sau 3 lượt dính cổng cứng trong 24 giờ — chặn tin mới, không phải gậy (spec hard-gates). Bảng đệm, tính
/// lại được từ `screening_runs`.
model ScreeningCooldown {
  accountId String   @id @map("account_id") @db.Uuid
  until     DateTime @db.Timestamptz(3)
  startedAt DateTime @map("started_at") @db.Timestamptz(3)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("screening_cooldowns")
}

/// Khoảng giá thường thấy của danh mục [P10 ÷ 2, P90 × 2] trên giá khác 0 trong 90 ngày (câu 7), tính lại mỗi đêm. Bảng
/// đệm. CHECK tay (migration init_screening):
///   category_price_stats_range_check: low >= 0 AND low <= high AND samples >= 0
model CategoryPriceStat {
  categoryId String   @id @map("category_id") @db.Uuid
  low        BigInt
  high       BigInt
  samples    Int
  computedAt DateTime @map("computed_at") @db.Timestamptz(3)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@map("category_price_stats")
}

/// Từ khoá suy ra danh mục cho dấu hiệu "sai danh mục" (design mục 3) — master và staff của danh mục nuôi.
model CategoryKeyword {
  categoryId    String @map("category_id") @db.Uuid
  keywordFolded String @map("keyword_folded")

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([categoryId, keywordFolded])
  @@map("category_keywords")
}

// ── REVIEW: ENUM ─────────────────────────────────────────────────────────────────────────────────

/// Lý do một việc có mặt trong hàng chờ; số hàng của việc = số nhỏ nhất trong các lý do (TK 16). `appeal` (hàng 2) do
/// add-strikes thêm. `report_severe` = báo cáo có lượt lừa đảo / hàng cấm — luôn về staff (TK 23).
enum ReviewReason {
  machine_hold
  machine_restricted
  group_escalation
  sample_risk
  sample_reviewer
  report
  report_severe
  /// Hàng 2 (add-strikes): khiếu nại gậy thường / nặng; gậy nghiêm trọng chờ master; khoá vĩnh viễn tới kỳ xem lại.
  appeal
  serious_strike
  permanent_review

  @@map("review_reason")
}

enum ReviewTaskStatus {
  open
  decided
  cancelled

  @@map("review_task_status")
}

/// Vì sao việc khép lại — chỉ `expired` (mẫu quá hạn) tính vào "bỏ sót" của hậu kiểm tuần.
enum ReviewCloseCause {
  decided
  expired
  machine_passed
  edited
  withdrawn
  listing_closed
  listing_deleted
  member_left
  group_closed
  /// Việc về gậy đóng vì gậy đã đổi ở đường khác: ân xá, hết hạn, quyết qua việc khác (add-strikes).
  strike_closed

  @@map("review_close_cause")
}

/// `restore` và `remove` không qua việc là thao tác trực tiếp của staff danh mục và master (TK 6).
enum ReviewOutcome {
  pass
  reject
  remove
  detach
  dismiss
  restore
  /// Quyết định về báo cáo không đổi tin (add-reports).
  keep
  /// Từ chối / gỡ vì vi phạm kèm gậy (add-strikes) — tin thành `rejected` / `removed` với `fault = violation`.
  violation

  @@map("review_outcome")
}

/// `violation` (kèm gậy) do add-strikes dùng — khai sẵn để khỏi ALTER TYPE.
enum ReviewSeverity {
  mistake
  violation

  @@map("review_severity")
}

/// Người xử ghi khi cho đạt việc máy giữ (TK 17): giữ là hợp lý dù tin ổn, hay không đáng giữ.
enum ReviewMachineJudgment {
  machine_right
  machine_overreach

  @@map("review_machine_judgment")
}

enum ReviewActorRole {
  master
  staff
  moderator
  owner

  @@map("review_actor_role")
}

// ── REVIEW: BẢNG ─────────────────────────────────────────────────────────────────────────────────

/// Một việc trong hàng chờ (design add-review-queues mục 2–5). Phạm vi (`category_id`, `group_id`, `unit_id`,
/// `placement`) chép từ tin mỗi lần việc được chạm; ai xử tính lúc đọc từ phạm vi và `excluded_ids`. CHECK tay
/// (migration init_review):
///   review_tasks_reasons_check: status <> 'open' OR COALESCE(cardinality(reasons), 0) > 0
///   review_tasks_queue_check:   queue BETWEEN 0 AND 5
///   review_tasks_claim_check:   (claimed_by IS NULL) = (claim_expires_at IS NULL) AND (claimed_by IS NOT NULL OR claimed_version IS NULL)
///                               AND (claimed_by IS NULL OR listing_id IS NULL OR claimed_version IS NOT NULL)
///   review_tasks_closed_check:  (status = 'open') = (closed_at IS NULL) AND (status = 'open') = (close_cause IS NULL)
///   review_tasks_subject_check: đúng một trong listing_id / account_id / strike_id — việc về một tin, một người
///                               (add-reports) hay một gậy (add-strikes)
model ReviewTask {
  id                String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  listingId         String?           @map("listing_id") @db.Uuid
  /// Việc về một người (báo cáo về người — add-reports).
  accountId         String?           @map("account_id") @db.Uuid
  /// Việc về một gậy (add-strikes): khiếu nại, gậy nghiêm trọng chờ master, xem lại khoá vĩnh viễn.
  strikeId          String?           @map("strike_id") @db.Uuid
  status            ReviewTaskStatus  @default(open)
  reasons           ReviewReason[]
  queue             Int               @db.SmallInt
  categoryId        String?           @map("category_id") @db.Uuid
  groupId           String?           @map("group_id") @db.Uuid
  unitId            String?           @map("unit_id") @db.Uuid
  placement         ListingPlacement?
  dueAt             DateTime          @map("due_at") @db.Timestamptz(3)
  /// Quá hạn đã chuyển master — chỉ master xử từ đây (TK 16).
  escalatedAt       DateTime?         @map("escalated_at") @db.Timestamptz(3)
  /// Người không được xử: người đăng, người chuyển lên, người đã cho đạt, và tài khoản dùng chung máy với họ.
  excludedIds       String[]          @default([]) @map("excluded_ids") @db.Uuid
  escalatedBy       String?           @map("escalated_by") @db.Uuid
  escalationNote    String?           @map("escalation_note")
  /// Mẫu hậu kiểm người duyệt: quyết định "đạt" đang được xem lại — để tính tỉ lệ bị lật.
  sampledDecisionId String?           @map("sampled_decision_id") @db.Uuid
  claimedBy         String?           @map("claimed_by") @db.Uuid
  claimExpiresAt    DateTime?         @map("claim_expires_at") @db.Timestamptz(3)
  /// Phiên bản tin lúc nhận — quyết định chỉ áp lên nội dung người xử đã thấy.
  claimedVersion    Int?              @map("claimed_version")
  remindedAt        DateTime?         @map("reminded_at") @db.Timestamptz(3)
  closeCause        ReviewCloseCause? @map("close_cause")
  closedAt          DateTime?         @map("closed_at") @db.Timestamptz(3)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  listing Listing? @relation(fields: [listingId], references: [id], onDelete: Cascade)

  /// Một tin, một việc đang mở (TK 16) — hai lối sinh việc cùng lúc vẫn ra một việc.
  @@unique([listingId], where: raw("status = 'open'"), map: "review_tasks_open_listing_key")
  /// Một người, một việc đang mở — như với tin.
  @@unique([accountId], where: raw("status = 'open'"), map: "review_tasks_open_account_key")
  @@unique([strikeId], where: raw("status = 'open'"), map: "review_tasks_open_strike_key")
  @@index([categoryId], where: raw("status = 'open'"), map: "review_tasks_open_category_idx")
  @@index([groupId], where: raw("status = 'open'"), map: "review_tasks_open_group_idx")
  @@index([dueAt], where: raw("status = 'open'"), map: "review_tasks_open_due_idx")
  @@index([closedAt], where: raw("status <> 'open'"), map: "review_tasks_closed_idx")
  @@map("review_tasks")
}

/// Nhật ký quyết định của người (TK 17): không chứa nội dung tin; không FK sang tin hay tài khoản — giữ theo hạn lưu
/// riêng (add-data-retention). CHECK tay (migration init_review):
///   review_decisions_severity_check: (outcome IN ('reject', 'remove')) = (severity IS NOT NULL)
///   review_decisions_judgment_check: machine_judgment IS NULL OR outcome = 'pass'
///   review_decisions_subject_check:  đúng một trong listing_id / account_id / strike_id,
///                                    và (listing_id IS NULL) = (listing_state_after IS NULL) (add-reports, add-strikes)
///   review_decisions_report_check:   (report_id IS NULL) = (report_verdict IS NULL)
model ReviewDecision {
  id                  String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  taskId              String?                @map("task_id") @db.Uuid
  listingId           String?                @map("listing_id") @db.Uuid
  /// Quyết định về một người (việc về người).
  accountId           String?                @map("account_id") @db.Uuid
  /// Quyết định về một gậy: khiếu nại, gậy nghiêm trọng, xem lại khoá vĩnh viễn (add-strikes).
  strikeId            String?                @map("strike_id") @db.Uuid
  /// Gậy quyết định này ra — nhật ký ghi hậu quả thật (add-strikes).
  issuedStrikeId      String?                @map("issued_strike_id") @db.Uuid
  actorId             String                 @map("actor_id") @db.Uuid
  actorRole           ReviewActorRole        @map("actor_role")
  outcome             ReviewOutcome
  severity            ReviewSeverity?
  reasonTemplateId    String?                @map("reason_template_id") @db.Uuid
  reasonText          String?                @map("reason_text")
  note                String?
  machineJudgment     ReviewMachineJudgment? @map("machine_judgment")
  machineOutcome      ScreeningOutcome?      @map("machine_outcome")
  machineHits         String[]               @default([]) @map("machine_hits")
  taskReasons         ReviewReason[]         @default([]) @map("task_reasons")
  queue               Int?                   @db.SmallInt
  listingStateAfter   ListingState?          @map("listing_state_after")
  posterTierAfter     TrustTier?             @map("poster_tier_after")
  /// Quyết định "đạt" mà lần hậu kiểm này lật (gỡ tin hay gỡ khỏi nhóm).
  overturnsDecisionId String?                @map("overturns_decision_id") @db.Uuid
  /// Báo cáo quyết định này đóng, và kết quả của nó (add-reports).
  reportId            String?                @map("report_id") @db.Uuid
  reportVerdict       ReportVerdict?         @map("report_verdict")
  decidedAt           DateTime               @map("decided_at") @db.Timestamptz(3)

  @@index([actorId, decidedAt])
  @@index([listingId, decidedAt])
  @@index([overturnsDecisionId], where: raw("overturns_decision_id IS NOT NULL"), map: "review_decisions_overturns_idx")
  @@map("review_decisions")
}

/// Lý do mẫu cho "sai sót" — master soạn, dùng chung mọi danh mục (chốt 15/10/2026).
model ReviewReasonTemplate {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  text      String   @unique
  active    Boolean  @default(true)
  sort      Int      @default(0)
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("review_reason_templates")
}

/// Tin vừa lên bảng chờ lượt lấy mẫu mỗi giờ (TK 16) — lượt lấy mẫu xét rồi xoá.
model ReviewSampleCandidate {
  listingId      String   @map("listing_id") @db.Uuid
  listingVersion Int      @map("listing_version")
  wentLiveAt     DateTime @map("went_live_at") @db.Timestamptz(3)
  /// Người cho đạt / khôi phục phiên bản này — loại khỏi việc mẫu của chính quyết định đó (fix-audit-review, T2).
  approvedBy     String?  @map("approved_by") @db.Uuid

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([listingId, listingVersion])
  @@map("review_sample_candidates")
}

// ── REVIEW: BÁO CÁO (add-reports) ────────────────────────────────────────────────────────────────

/// Năm loại báo cáo cố định để thống kê được (TK 23).
enum ReportCategory {
  fraud
  misinformation
  harassment
  prohibited
  other

  @@map("report_category")
}

enum ReportSubjectKind {
  listing
  account

  @@map("report_subject_kind")
}

enum ReportStatus {
  open
  upheld
  dismissed

  @@map("report_status")
}

enum ReportVerdict {
  upheld
  dismissed

  @@map("report_verdict")
}

/// Một báo cáo về một đối tượng — mọi lượt báo trong lúc nó mở gộp vào đây (TK 23). Không khoá ngoại sang tin hay tài
/// khoản: báo cáo sống qua lượt xoá của chủ, xử trên bản lưu (cam kết 25). CHECK tay (migration add_reports):
///   reports_subject_check: (subject_kind = 'listing') = (listing_id IS NOT NULL)
///   reports_decided_check: (status = 'open') = (decided_at IS NULL)
model Report {
  id           String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  subjectKind  ReportSubjectKind @map("subject_kind")
  listingId    String?           @map("listing_id") @db.Uuid
  /// Người bị báo; với báo cáo về tin là người đăng tin.
  accountId    String            @map("account_id") @db.Uuid
  status       ReportStatus      @default(open)
  /// Có ít nhất một lượt lừa đảo hay hàng cấm — luật của hai loại đó thắng khi gộp.
  severe       Boolean           @default(false)
  /// Mọi lượt báo đều của người có điểm báo cáo dưới mức bình thường — xếp cuối hàng.
  lowPriority  Boolean           @default(false) @map("low_priority")
  /// Lúc tin bị tạm ẩn vì nhiều người báo; null = chưa.
  autoHiddenAt DateTime?         @map("auto_hidden_at") @db.Timestamptz(3)
  decisionId   String?           @map("decision_id") @db.Uuid
  decidedAt    DateTime?         @map("decided_at") @db.Timestamptz(3)
  createdAt    DateTime          @map("created_at") @db.Timestamptz(3)

  entries ReportEntry[]

  @@unique([listingId], where: raw("status = 'open'"), map: "reports_open_listing_key")
  @@unique([accountId], where: raw("status = 'open' AND subject_kind = 'account'"), map: "reports_open_account_key")
  @@index([accountId, createdAt])
  @@index([listingId, createdAt])
  @@map("reports")
}

/// Một lượt báo: một người một lượt trong một báo cáo. `counts_for_hide` chụp lúc báo — có dấu máy, mức đủ, điểm bình
/// thường (TK 23).
model ReportEntry {
  id             String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  reportId       String         @map("report_id") @db.Uuid
  reporterId     String         @map("reporter_id") @db.Uuid
  category       ReportCategory
  deviceHash     String?        @map("device_hash")
  countsForHide  Boolean        @map("counts_for_hide")
  /// Lượt báo gửi từ hội thoại: hội thoại làm bằng chứng cho người xử (add-messaging). Không FK: `messaging` sở hữu
  /// bảng, báo cáo sống lâu hơn hội thoại (hạn lưu là việc của `add-data-retention`).
  conversationId String?        @map("conversation_id") @db.Uuid
  createdAt      DateTime       @map("created_at") @db.Timestamptz(3)

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, reporterId])
  @@index([reporterId, createdAt])
  @@index([conversationId], where: raw("conversation_id IS NOT NULL"), map: "report_entries_conversation_idx")
  @@map("report_entries")
}

/// Điểm tin cậy báo cáo (TK 23): bác −1, đúng +1. Không phải án phạt — không module nào khác đọc.
model ReporterScore {
  accountId      String    @id @map("account_id") @db.Uuid
  score          Int       @default(0)
  /// Mất quyền báo cáo tới lúc này (điểm xuống dưới mức mất quyền).
  suspendedUntil DateTime? @map("suspended_until") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("reporter_scores")
}

// ── TRUST: GẬY (add-strikes) ─────────────────────────────────────────────────────────────────────

enum StrikeKind {
  normal
  severe
  serious

  @@map("strike_kind")
}

/// `permanent` / `lifted` chỉ với gậy nghiêm trọng (TK 22).
enum StrikeStatus {
  active
  expired
  cancelled
  permanent
  lifted

  @@map("strike_status")
}

enum StrikeCancelCause {
  appeal
  amnesty
  serious_cancel

  @@map("strike_cancel_cause")
}

enum SeriousDecision {
  permanent
  downgrade
  cancel

  @@map("serious_decision")
}

enum AppealChannel {
  app
  support

  @@map("appeal_channel")
}

enum AppealStatus {
  pending
  won
  lost
  closed

  @@map("appeal_status")
}

/// Quy định sàn để trích khi ra gậy (TK 21, cam kết 9) — master soạn; gậy giữ bản trích lúc ra.
model RuleArticle {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  code      String   @unique
  title     String
  text      String
  active    Boolean  @default(true)
  sort      Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  strikes Strike[]

  @@map("rule_articles")
}

/// Một gậy (TK 21, 22). Chỉ `trust` ghi. Không khoá ngoại sang tin, quyết định, người ra, và từ add-data-retention cả
/// người nhận: gậy sống lâu hơn chúng, và ẩn danh hoá thay `account_id` bằng mã giả không trỏ tới ai. Đăng ký dở bị dọn
/// thì `trust` nghe `identity.account.purged` mà xoá gậy đã kế thừa.
/// `email_hashes` = dấu băm email của tài khoản lúc ra gậy, thêm dấu mới khi đổi email — tài khoản lập lại bằng một
/// trong các email đó kế thừa gậy còn hiệu lực. CHECK tay (migration add_strikes):
///   strikes_expiry_check:    (kind = 'serious') = (expires_at IS NULL) với gậy chưa hạ — ghi dưới dạng
///                            kind <> 'serious' OR expires_at IS NULL
///   strikes_cancel_check:    (status = 'cancelled') = (cancelled_at IS NOT NULL) AND (status = 'cancelled') = (cancel_cause IS NOT NULL)
///   strikes_permanent_check: status NOT IN ('permanent', 'lifted') OR serious_decision = 'permanent'
///   strikes_lifted_check:    (status = 'lifted') = (lifted_at IS NOT NULL)
model Strike {
  id                String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  accountId         String             @map("account_id") @db.Uuid
  kind              StrikeKind
  status            StrikeStatus       @default(active)
  points            Int
  ruleArticleId     String             @map("rule_article_id") @db.Uuid
  ruleText          String             @map("rule_text")
  issuedBy          String             @map("issued_by") @db.Uuid
  issuedByRole      ReviewActorRole    @map("issued_by_role")
  /// Danh mục của tin — staff khác của danh mục xét khiếu nại; null = chỉ master (gậy do master ra, báo cáo về người).
  categoryId        String?            @map("category_id") @db.Uuid
  fromReport        Boolean            @default(false) @map("from_report")
  listingId         String?            @map("listing_id") @db.Uuid
  decisionId        String?            @map("decision_id") @db.Uuid
  emailHashes       String[]           @default([]) @map("email_hashes")
  inheritedFromId   String?            @map("inherited_from_id") @db.Uuid
  issuedAt          DateTime           @map("issued_at") @db.Timestamptz(3)
  expiresAt         DateTime?          @map("expires_at") @db.Timestamptz(3)
  cancelledAt       DateTime?          @map("cancelled_at") @db.Timestamptz(3)
  cancelCause       StrikeCancelCause? @map("cancel_cause")
  cancelledBy       String?            @map("cancelled_by") @db.Uuid
  seriousDecision   SeriousDecision?   @map("serious_decision")
  seriousDecidedAt  DateTime?          @map("serious_decided_at") @db.Timestamptz(3)
  seriousDecidedBy  String?            @map("serious_decided_by") @db.Uuid
  /// Kỳ xem lại kế tiếp của khoá vĩnh viễn (mỗi `strike.permanentReviewYears`).
  permanentReviewAt DateTime?          @map("permanent_review_at") @db.Timestamptz(3)
  liftedAt          DateTime?          @map("lifted_at") @db.Timestamptz(3)
  liftedBy          String?            @map("lifted_by") @db.Uuid
  /// Đã ẩn danh hoá (add-data-retention): `account_id` là mã giả, `email_hashes` rỗng, lời khiếu nại xoá.
  anonymizedAt      DateTime?          @map("anonymized_at") @db.Timestamptz(3)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  article  RuleArticle     @relation(fields: [ruleArticleId], references: [id])
  appeal   StrikeAppeal?
  comments StrikeComment[]

  @@index([accountId, status])
  @@index([status, expiresAt], where: raw("status = 'active'"), map: "strikes_active_expiry_idx")
  @@index([permanentReviewAt], where: raw("status = 'permanent'"), map: "strikes_permanent_review_idx")
  @@index([emailHashes], type: Gin)
  @@index([status], where: raw("anonymized_at IS NULL"), map: "strikes_anonymize_due_idx")
  @@map("strikes")
}

/// Khiếu nại một gậy — mỗi gậy đúng một lần (TK 22). `decided_by` null khi tự thắng vì quá hạn xét.
model StrikeAppeal {
  id        String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  strikeId  String        @unique @map("strike_id") @db.Uuid
  accountId String        @map("account_id") @db.Uuid
  channel   AppealChannel
  statement String
  status    AppealStatus  @default(pending)
  filedAt   DateTime      @map("filed_at") @db.Timestamptz(3)
  decidedAt DateTime?     @map("decided_at") @db.Timestamptz(3)
  decidedBy String?       @map("decided_by") @db.Uuid

  strike Strike @relation(fields: [strikeId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("strike_appeals")
}

/// Nhận xét của staff trên hồ sơ gậy nghiêm trọng đang chờ master (TK 22).
model StrikeComment {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  strikeId  String   @map("strike_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  body      String
  createdAt DateTime @map("created_at") @db.Timestamptz(3)

  strike Strike @relation(fields: [strikeId], references: [id], onDelete: Cascade)

  @@index([strikeId, createdAt])
  @@map("strike_comments")
}

// ── MESSAGING (add-messaging) ────────────────────────────────────────────────────────────────────

/// Hội thoại (TK 24); `messaging` sở hữu. Ba loại (add-team-conversations): về một tin (người mua ↔ người đăng), với Hỗ
/// trợ Ghim, với quản trị một nhóm. Cột "phía tôi" theo vai mua / bán thay vì bảng thành viên riêng (design add-messaging,
/// Risks); với hội thoại với một đội, `buyer_id` là người dùng và phía "seller" là cả đội — `seller_read_at` là đã đọc
/// chung của đội, `seller_hidden_at` luôn NULL. Không khoá ngoại sang `listings` (bỏ ở add-data-retention) hay `groups`:
/// hội thoại theo hạn lưu riêng, tin bị xoá hẳn thì hội thoại còn và DTO trả tiêu đề null.
/// CHECK tay (migration add_messaging, add_team_conversations):
///   conversations_parties_check: buyer_id <> seller_id
///   conversations_kind_check: listing → listing_id, seller_id NOT NULL, group_id, team_pending_since NULL;
///     support → listing_id, seller_id, group_id NULL; group → group_id NOT NULL, listing_id, seller_id NULL
model Conversation {
  id               String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  kind             ConversationKind @default(listing)
  listingId        String?          @map("listing_id") @db.Uuid
  sellerId         String?          @map("seller_id") @db.Uuid
  groupId          String?          @map("group_id") @db.Uuid
  buyerId          String           @map("buyer_id") @db.Uuid
  /// Tin đầu tiên của người dùng mà đội chưa trả lời — khoá sắp xếp của hàng hỗ trợ; đội gửi thì về NULL.
  teamPendingSince DateTime?        @map("team_pending_since") @db.Timestamptz(3)
  createdAt        DateTime         @map("created_at") @db.Timestamptz(3)
  /// Khoá con trỏ của danh sách: lúc mở, rồi lúc mỗi tin nhắn.
  lastActivityAt   DateTime         @map("last_activity_at") @db.Timestamptz(3)
  lastMessageAt    DateTime?        @map("last_message_at") @db.Timestamptz(3)
  /// Tin nhắn đã tới của người mua — dữ kiện "có người nhắn hỏi mua" của tin sạch (TK 20).
  buyerMessages    Int              @default(0) @map("buyer_messages")
  /// Xoá hội thoại chỉ ẩn phía mình; bên kia nhắn tiếp thì bỏ ẩn.
  buyerHiddenAt    DateTime?        @map("buyer_hidden_at") @db.Timestamptz(3)
  sellerHiddenAt   DateTime?        @map("seller_hidden_at") @db.Timestamptz(3)
  buyerReadAt      DateTime?        @map("buyer_read_at") @db.Timestamptz(3)
  sellerReadAt     DateTime?        @map("seller_read_at") @db.Timestamptz(3)

  seller    Account?               @relation("conversation_seller", fields: [sellerId], references: [id], onDelete: Cascade)
  buyer     Account                @relation("conversation_buyer", fields: [buyerId], references: [id], onDelete: Cascade)
  messages  Message[]
  presences ConversationPresence[]

  /// Một tin, một người mua, một hội thoại — hai lượt mở cùng lúc vẫn ra một.
  @@unique([listingId, buyerId])
  /// Một hội thoại hỗ trợ mỗi người, một hội thoại mỗi người + nhóm (spec support-chat, group-admin-chat).
  @@unique([buyerId], map: "conversations_one_support", where: raw("kind = 'support'"))
  @@unique([groupId, buyerId], map: "conversations_one_group", where: raw("kind = 'group'"))
  @@index([buyerId, lastActivityAt])
  @@index([sellerId, lastActivityAt])
  @@index([lastActivityAt], map: "conversations_retention_idx")
  @@index([teamPendingSince, lastActivityAt], map: "conversations_support_queue", where: raw("kind = 'support'"))
  @@index([groupId, lastActivityAt], map: "conversations_group_idx", where: raw("kind = 'group'"))
  @@map("conversations")
}

enum ConversationKind {
  listing
  support
  group

  @@map("conversation_kind")
}

/// Tin nhắn chữ hoặc đề nghị giá (add-price-offers): đề nghị là một loại tin nhắn để đi chung con trỏ, hạn lưu, bản ghi
/// cho người xử và thông báo (design add-price-offers mục 1). CHECK tay (migration add_price_offers):
///   messages_kind_check: text → body <> '' và ba cột đề nghị NULL; offer → body = '', offer_amount > 0,
///     offer_status NOT NULL, offer_responded_at NOT NULL đúng khi đã chấp nhận / từ chối
model Message {
  id               String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  conversationId   String       @map("conversation_id") @db.Uuid
  senderId         String       @map("sender_id") @db.Uuid
  kind             MessageKind  @default(text)
  /// Đề nghị giá để rỗng: mọi chỗ đọc chữ (bản ghi, bộ lọc, câu thông báo) không phải học nhánh NULL.
  body             String
  /// Trúng cụm từ cấm mức mơ hồ đang bật — chỉ người xử thấy; mức chắc thì tin nhắn không được lưu (design mục 4).
  flagged          Boolean      @default(false)
  /// Đồng, như giá tin.
  offerAmount      BigInt?      @map("offer_amount")
  offerStatus      OfferStatus? @map("offer_status")
  offerRespondedAt DateTime?    @map("offer_responded_at") @db.Timestamptz(3)
  createdAt        DateTime     @map("created_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       Account      @relation(fields: [senderId], references: [id], onDelete: Cascade)

  /// Mỗi hội thoại tối đa một đề nghị đang chờ (spec messaging/price-offers) — lớp cuối nếu đường ghi nào quên khoá.
  @@unique([conversationId], map: "messages_one_pending_offer", where: raw("offer_status = 'pending'"))
  @@index([conversationId, createdAt, id])
  @@map("messages")
}

enum MessageKind {
  text
  offer

  @@map("message_kind")
}

enum OfferStatus {
  pending
  accepted
  declined
  superseded

  @@map("offer_status")
}

/// Chặn người (TK 24): một dòng theo chiều người chặn → người bị chặn; "bị chặn" là có dòng theo một trong hai chiều.
/// CHECK tay (migration add_messaging): account_blocks_self_check: blocker_id <> blocked_id
model AccountBlock {
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @map("created_at") @db.Timestamptz(3)

  blocker Account @relation("block_blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked Account @relation("block_blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("account_blocks")
}

/// Máy (phiên) đang mở đúng một hội thoại — tin nhắn của hội thoại đó không đẩy lên máy ấy (add-notifications, design
/// mục 4). Hiệu lực ngắn, app gọi lại khi còn mở; `messaging` sở hữu.
model ConversationPresence {
  sessionId      String   @id @map("session_id") @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)

  session      Session      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("conversation_presences")
}

// ── NOTIFICATION — PUSH (add-notifications) ──────────────────────────────────────────────────────

/// Ticket Expo của một lượt đẩy đã nhận: đọc biên nhận sau 15 phút, máy đã gỡ app thì quên token (design mục 3).
model PushTicket {
  /// Mã ticket do Expo cấp.
  id        String   @id
  sessionId String   @map("session_id") @db.Uuid
  token     String
  createdAt DateTime @map("created_at") @db.Timestamptz(3)

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@map("push_tickets")
}

// ── OPS (add-data-retention) ─────────────────────────────────────────────────────────────────────

enum JobRunStatus {
  done
  partial
  failed

  @@map("job_run_status")
}

/// Kết quả mỗi lượt việc theo lịch (TK 26 luật 2 "làm dở thì phải nói ra"): `lib/jobs.ts` ghi qua `runLog` sau mỗi lượt,
/// `ops` sở hữu và dọn (90 ngày). Việc theo sự kiện không ghi — lô nhỏ, hàng trăm lượt mỗi giờ.
model JobRun {
  id         String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name       String
  status     JobRunStatus
  startedAt  DateTime     @map("started_at") @db.Timestamptz(3)
  finishedAt DateTime     @map("finished_at") @db.Timestamptz(3)
  summary    Json         @default("{}") @db.JsonB
  error      String?

  @@index([name, startedAt(sort: Desc)])
  @@index([startedAt])
  @@map("job_runs")
}
